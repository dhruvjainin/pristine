---
import "../styles/global.css";

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const nav = [
  { href: "/#commands", label: "Commands" },
  { href: "/#examples", label: "Examples" },
  { href: "/#built", label: "Built with" },
  { href: "/#laws", label: "Laws" },
  { href: "/docs/", label: "Docs" },
  { href: "/#install", label: "Install" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pristine" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pristine: your agent ships UI, Pristine makes it look designed." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f5f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="container top__inner">
        <a class="wordmark" href="/" aria-label="Pristine home">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.5 12.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>pristine</span>
        </a>
        <nav aria-label="Primary" class="top__nav">
          {nav.filter((n) => n.label !== "Install").map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="top__actions">
          <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
            <svg class="theme__sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <svg class="theme__moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </button>
          <a class="top__icon" href="https://github.com/maddhruv/pristine" aria-label="Pristine on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.86c-2.92.63-3.54-1.24-3.54-1.24-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.08-.64.08-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.66-1.4-2.33-.27-4.78-1.17-4.78-5.18 0-1.15.41-2.08 1.08-2.82-.11-.26-.47-1.33.1-2.77 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.44.22 2.51.11 2.77.67.74 1.08 1.67 1.08 2.82 0 4.02-2.46 4.9-4.8 5.16.38.33.72.97.72 1.96v2.9c0 .28.19.61.73.5A10.5 10.5 0 0 0 12 1.5z"/></svg>
          </a>
          <a class="btn top__cta" href="/#install">Install</a>
          <details class="menu" data-menu>
            <summary class="top__icon" aria-label="Menu">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </summary>
            <nav aria-label="Primary" class="menu__panel">
              {nav.filter((n) => n.label !== "Install").map((n) => <a href={n.href}>{n.label}</a>)}
              <a class="btn" href="/#install">Install</a>
              <a href="https://github.com/maddhruv/pristine">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="container foot__inner">
        <p>Pristine is an open agent skill for Claude Code, Copilot, and any agent that reads <code>SKILL.md</code>.</p>
        <p class="foot__meta">This site was designed and polished with Pristine. Every demo is a real page you can open.</p>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const isDark = () => root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      const sync = () => btn?.setAttribute("aria-pressed", String(isDark()));
      sync();
      btn?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
        window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
      });
      const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
      if (menu) {
        menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => { menu.open = false; }));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
        });
        document.addEventListener("click", (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
      }
    </script>
    <style>
      .skip { position: absolute; left: var(--s-4); top: -60px; z-index: 50; padding: var(--s-2) var(--s-4); background: var(--ink); color: var(--on-ink); border-radius: var(--radius-sm); }
      .skip:focus { top: var(--s-4); }
      .top { position: sticky; top: 0; z-index: 20; background: color-mix(in oklab, var(--paper) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); padding-top: env(safe-area-inset-top); }
      .top__inner { display: flex; align-items: center; gap: var(--s-6); min-height: 64px; }
      .wordmark { display: inline-flex; align-items: center; gap: var(--s-2); font: 500 1.25rem/1 var(--font-display); letter-spacing: -0.02em; text-decoration: none; }
      .top__nav { display: flex; gap: var(--s-5); margin-right: auto; }
      .top__nav a { color: var(--ink-2); text-decoration: none; font-size: var(--text-sm); padding-block: var(--s-3); transition: color var(--dur-state) var(--ease-out); }
      .top__actions { display: flex; align-items: center; gap: var(--s-2); }
      .top__cta { min-height: 40px; padding-inline: var(--s-4); }
      .top__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-sm); color: var(--ink-2); cursor: pointer; list-style: none; transition: background-color var(--dur-state) var(--ease-out), color var(--dur-state) var(--ease-out); }
      .top__icon::-webkit-details-marker { display: none; }
      .top__icon:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
      .menu { display: none; }
      .menu__panel { position: absolute; left: 0; right: 0; top: 100%; display: grid; padding: var(--s-2) var(--gutter) var(--s-5); background: var(--paper); border-bottom: 1px solid var(--rule); box-shadow: var(--shadow); }
      .menu__panel a:not(.btn) { display: flex; align-items: center; min-height: 48px; color: var(--ink); text-decoration: none; font-size: var(--text-md); border-bottom: 1px solid var(--rule); }
      .menu__panel .btn { margin-top: var(--s-4); }
      .menu[open] > summary { background: var(--surface-2); color: var(--ink); }
      .theme { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid transparent; border-radius: var(--radius-sm); background: none; color: var(--ink-2); cursor: pointer; transition: background-color var(--dur-state) var(--ease-out), color var(--dur-state) var(--ease-out); }
      .theme__moon { display: none; }
      :global([data-theme="dark"]) .theme__sun { display: none; }
      :global([data-theme="dark"]) .theme__moon { display: block; }
      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .theme__sun { display: none; }
        :global(:root:not([data-theme="light"])) .theme__moon { display: block; }
      }
      @media (hover: hover) and (pointer: fine) {
        .top__nav a:hover, .theme:hover, .top__icon:hover { color: var(--ink); }
        .theme:hover, .top__icon:hover { background: var(--surface-2); }
      }
      @media (max-width: 640px) {
        .top__nav, .top__cta, .top__actions > .top__icon { display: none; }
        .wordmark { margin-right: auto; }
        .menu { display: block; }
      }
      .foot { border-top: 1px solid var(--rule); padding-block: var(--s-7) calc(var(--s-7) + env(safe-area-inset-bottom)); color: var(--ink-2); font-size: var(--text-sm); }
      .foot__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-4); }
      .foot__meta { color: var(--ink-3); }
    </style>
  </body>
</html>
