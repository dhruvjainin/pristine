---
import Base from "../../layouts/Base.astro";
import Copy from "../../components/Copy.astro";
import DocsNav from "../../components/DocsNav.astro";
import { commandDocs, lensDocs, lensGroups } from "../../data/docs";
import { routes } from "../../data/commands";
---
<Base title="Command reference · Pristine" description="Every Pristine command and Lens, with real prompts to try, what each one does step by step, and how to check the result.">
  <div class="container docs">
    <aside class="docs__side"><DocsNav /></aside>
    <article class="docs__main">
      <header class="dhead">
        <p class="eyebrow">Command reference</p>
        <h1>Say what you want. Or name the exact move.</h1>
        <p class="lede">You don't need a special command: describe the outcome and a bare <code>/pristine</code> picks the right one. When you know what kind of change you want, use a command, or name a Lens after <code>polish</code>.</p>
      </header>

      <section aria-labelledby="start-h" class="dsec">
        <h2 id="start-h">Start here</h2>
        <div class="start">
          <div>
            <h3>Build something new</h3>
            <p>A page, a component, or a redesign in a new direction.</p>
            <Copy cmd="/pristine design a signup page for our monthly book club" wrap label="Copy design example" />
            <a class="more" href="/docs/design/">How design works</a>
          </div>
          <div>
            <h3>Improve what you have</h3>
            <p>Keep the look; fix what's holding it back.</p>
            <Copy cmd="/pristine polish the pricing page, keep the current layout" wrap label="Copy polish example" />
            <a class="more" href="/docs/polish/">How polish works</a>
          </div>
          <div>
            <h3>Just want a score</h3>
            <p>Honest review, out of 10, without touching code.</p>
            <Copy cmd="/pristine critique localhost:3000/checkout" wrap label="Copy critique example" />
            <a class="more" href="/docs/critique/">How critique works</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="cmd-h" class="dsec">
        <h2 id="cmd-h">Commands <span class="count mono num">{commandDocs.length}</span></h2>
        <ul class="ref">
          {commandDocs.map((c) => (
            <li>
              <a href={`/docs/${c.slug}/`}>
                <code class="ref__name">{c.name}</code>
                <span class="ref__line">{c.line}</span>
                <span class:list={["ref__tag mono", { "is-ro": !c.edits }]}>{c.edits ? "edits code" : "read-only"}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="lens-h" class="dsec">
        <h2 id="lens-h">Lenses <span class="count mono num">{lensDocs.length}</span></h2>
        <p class="dsec__p">Polish picks Lenses for you. Name them to force exactly those: <code>/pristine polish bolder animate the hero</code>. Design uses them as build rules.</p>
        {lensGroups.map((g) => (
          <div class="lgroup">
            <h3>{g.name} <span>{g.d}</span></h3>
            <ul class="ref">
              {lensDocs.filter((l) => l.group === g.id).map((l) => (
                <li>
                  <a href={`/docs/${l.slug}/`}>
                    <code class="ref__name">{l.name}</code>
                    <span class="ref__line">{l.line}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="route-h" class="dsec">
        <h2 id="route-h">What a bare <code>/pristine</code> runs</h2>
        <table class="routes">
          <caption class="visually-hidden">How plain requests are routed</caption>
          <thead><tr><th scope="col">You say</th><th scope="col">It runs</th></tr></thead>
          <tbody>{routes.map((r) => <tr><td>{r.ask}</td><td class="mono">{r.to}</td></tr>)}</tbody>
        </table>
        <p class="dsec__p">If it can't tell a redesign from a polish, it asks once. Otherwise it names the route in one line and starts.</p>
      </section>
    </article>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--s-8); padding-block: var(--s-7) var(--s-9); }
  .docs__side { position: sticky; top: 88px; align-self: start; max-height: calc(100dvh - 104px); overflow-y: auto; scrollbar-width: thin; }
  .docs__main { min-width: 0; max-width: 820px; }
  @media (max-width: 960px) { .docs { grid-template-columns: minmax(0, 1fr); } .docs__side { display: none; } }

  .dhead { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .dhead h1 { font-size: var(--text-3xl); }
  .dsec { margin-bottom: var(--s-8); }
  .dsec h2 { font-size: var(--text-2xl); margin-bottom: var(--s-4); display: flex; align-items: baseline; gap: var(--s-3); }
  .dsec h2 code { font-family: var(--font-display); font-style: italic; }
  .count { font-size: var(--text-sm); color: var(--ink-3); font-weight: 500; }
  .dsec__p { color: var(--ink-2); margin-bottom: var(--s-4); max-width: 64ch; }

  .start { display: grid; gap: var(--s-6); }
  .start > div { display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--ink); }
  .start h3 { font-size: var(--text-xl); }
  .start p { color: var(--ink-2); font-size: var(--text-sm); margin-bottom: var(--s-2); }
  .more { justify-self: start; font-size: var(--text-sm); padding-block: var(--s-2); }

  .ref { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ref a { display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: var(--s-4); align-items: baseline; padding: var(--s-3) var(--s-2); border-bottom: 1px solid var(--rule); color: var(--ink-2); text-decoration: none; transition: background-color var(--dur-state) var(--ease-out); }
  .ref a:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; border-radius: var(--radius-sm); }
  .ref__name { color: var(--ink); font-weight: 600; font-size: var(--text-md); }
  .ref__line { font-size: var(--text-sm); }
  .ref__tag { font-size: var(--text-xs); padding: 2px 6px; border: 1px solid var(--rule); border-radius: 4px; }
  .ref__tag.is-ro { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 40%, var(--rule)); }
  @media (hover: hover) and (pointer: fine) { .ref a:hover { background: var(--surface-2); } .ref a:hover .ref__name { text-decoration: underline; text-underline-offset: 3px; } }
  @media (max-width: 640px) { .ref a { grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-1) var(--s-3); } .ref__line { grid-column: 1 / -1; grid-row: 2; } }

  .lgroup { margin-top: var(--s-6); }
  .lgroup h3 { font: italic 400 var(--text-xl)/1.3 var(--font-display); margin-bottom: var(--s-3); }
  .lgroup h3 span { display: block; font: 400 var(--text-sm)/1.5 var(--font-body); color: var(--ink-2); margin-top: var(--s-1); }

  .routes { width: 100%; border-collapse: collapse; font-size: var(--text-sm); margin-bottom: var(--s-4); }
  .routes th { text-align: left; font: 500 var(--text-xs)/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .routes td { padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  .routes td.mono, .routes th:last-child { text-align: right; }
</style>
