---
import Base from "../layouts/Base.astro";
import Copy from "../components/Copy.astro";
import ExamplesWipe from "../components/ExamplesWipe.astro";
import { examples } from "../data/examples";
import { DIMENSIONS } from "../data/schema";
import { commands, routes, lenses, targets, levels } from "../data/commands";
import { laws, lawGroups } from "../data/laws";

const sprout = [
  { slug: "agent-fanout", name: "Agent Fanout", d: "A tree of agents, each with its model, tools, task, status and run time. Lines draw in as agents start." },
  { slug: "status", name: "Status", d: "Nine states in three sizes. Colour only where the state needs attention." },
  { slug: "state-panel", name: "State Panel", d: "Empty, loading and error states that say what happened and what to do next." },
  { slug: "sidebar", name: "Sidebar", d: "Workspace nav with groups, counts and a collapse that keeps your place." },
  { slug: "settings-list", name: "Settings List", d: "Label, help text and control on one line, with a clear saved state." },
  { slug: "command", name: "Command", d: "A command palette that filters inline and works from the keyboard alone." },
];

const install = "npx skills add maddhruv/pristine";
---
<Base title="Pristine: a design director for your coding agent" description="An agent skill that screenshots your UI, scores it out of 10 against your real users, and fixes it. Built for Claude Code, Copilot, and any agent that reads SKILL.md.">
  <section class="lead">
    <div class="container lead__in">
      <div class="lead__say">
        <p class="eyebrow">An agent skill for Claude Code, Copilot and more</p>
        <h1>Your agent ships UI.<br /><em>Pristine</em> makes it look designed.</h1>
      </div>
      <div class="lead__do">
        <p class="lede">It screenshots your real page, scores it out of 10 through your users' eyes, and fixes what holds it back. In light and dark, on desktop and mobile, and it looks again before it says it's done.</p>
        <Copy cmd={install} size="lg" label="Copy install command" />
      </div>
    </div>
  </section>

  <section class="section" id="examples" aria-labelledby="examples-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Examples</p>
        <h2 id="examples-h">Eight surfaces, before and after.</h2>
        <p class="lede">Drag the line. Left is what an agent ships unaided; right is the same product after one Pristine run.</p>
      </div>
      <ExamplesWipe />
    </div>
  </section>

  <section class="section" id="commands" aria-labelledby="commands-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Commands</p>
        <h2 id="commands-h">Four commands. Each one looks before it judges.</h2>
        <p class="lede">Every command reads your <code>DESIGN.md</code>, captures the real UI, and holds it to the same craft floor. Point any of them at a URL, a screenshot, a file, or a feature name.</p>
      </div>

      <ul class="rows">
        {commands.map((c, i) => (
          <li>
            <details class="row">
              <summary>
                <span class="row__n mono">0{i + 1}</span>
                <code class="row__name">{c.name}</code>
                <span class="row__does">{c.does}</span>
                <span class:list={["row__badge mono", { "is-ro": !c.edits }]}>{c.edits ? "edits code" : "read-only"}</span>
              </summary>
              <div class="row__more">
                <p class="row__when"><span class="mono">When</span> {c.when}</p>
                <Copy cmd={c.usage} label={`Copy ${c.name} example`} />
                <ul class="row__out">{c.out.map((o) => <li>{o}</li>)}</ul>
                <a href={`/docs/${c.name}/`}>Read the {c.name} docs</a>
              </div>
            </details>
          </li>
        ))}
      </ul>

      <div class="grid2">
        <div class="panel">
          <h3>Just type <code>/pristine</code></h3>
          <p>A bare invocation routes by what you ask for.</p>
          <table class="routes">
            <caption class="visually-hidden">How a bare /pristine routes</caption>
            <thead><tr><th scope="col">You say</th><th scope="col">It runs</th></tr></thead>
            <tbody>
              {routes.map((r) => <tr><td>{r.ask}</td><td class="mono">{r.to}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="panel">
          <h3>Point it at anything</h3>
          <p>Four kinds of target, resolved before any work starts.</p>
          <dl class="targets">
            {targets.map((t) => (<div><dt>{t.kind}</dt><dd class="mono">{t.eg}</dd></div>))}
          </dl>
          <h3 class="panel__sub">Or force a Lens</h3>
          <p><code>/pristine polish bolder animate</code> runs exactly those. Sixteen in all:</p>
          <ul class="chips">{lenses.map((l) => <li class="mono"><a href={`/docs/${l}/`}>{l}</a></li>)}</ul>
        </div>
      </div>
      <p class="cmds__more"><a class="btn btn--ghost" href="/docs/">Full command reference, with examples</a></p>
    </div>
  </section>

  <section class="section" id="built" aria-labelledby="built-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Built with Pristine</p>
        <h2 id="built-h">Sprout: 102 components, every one through <code>/pristine</code>.</h2>
        <p class="lede">A React 19 and Tailwind 4 component library on Base UI, in light and dark. Each component was designed, critiqued and polished with the skill, and each shows its real states, not a happy path.</p>
      </div>
      <a class="sprout__hero" href="https://sprout.tulipfarm.ai/" target="_blank" rel="noopener">
        <img src="/shots/sprout/home-light.webp" data-light="/shots/sprout/home-light.webp" data-dark="/shots/sprout/home-dark.webp" width="1200" height="750" alt="Sprout home page: A foundation for your next interface." loading="lazy" decoding="async" />
        <span class="sprout__visit">sprout.tulipfarm.ai <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></span>
      </a>
      <ul class="sprout">
        {sprout.map((c) => (
          <li>
            <a class="sprout__card" href={`https://sprout.tulipfarm.ai/components/${c.slug}/`} target="_blank" rel="noopener">
              <span class="sprout__shot">
                <img src={`/shots/sprout/${c.slug}-light.webp`} data-light={`/shots/sprout/${c.slug}-light.webp`} data-dark={`/shots/sprout/${c.slug}-dark.webp`} width="846" height="560" alt={`${c.name} component, live demo`} loading="lazy" decoding="async" />
              </span>
              <span class="sprout__meta">
                <b>{c.name} <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></b>
                <span>{c.d}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">How it judges</p>
        <h2 id="how-h">No guessing from the code. It looks.</h2>
        <p class="lede">Before scoring and after every fix, Pristine captures the target in four cells, using whatever browser your agent has: Claude in Chrome, a Playwright MCP, or its own bundled script.</p>
      </div>
      <div class="how">
        <div class="matrix" role="table" aria-label="Capture Matrix">
          <div role="row" class="matrix__row matrix__head"><span role="columnheader"></span><span role="columnheader" class="mono">Desktop 1440</span><span role="columnheader" class="mono">Mobile 390</span></div>
          <div role="row" class="matrix__row"><span role="rowheader" class="mono">Light</span><span role="cell" class="cell"><img src="/shots/saas-landing/after/desktop-light.webp" alt="Desktop, light capture of the SaaS landing page after Pristine" width="1440" height="900" loading="lazy" decoding="async" /></span><span role="cell" class="cell cell--m"><img src="/shots/saas-landing/after/mobile-light.webp" alt="Mobile, light capture" width="390" height="844" loading="lazy" decoding="async" /></span></div>
          <div role="row" class="matrix__row"><span role="rowheader" class="mono">Dark</span><span role="cell" class="cell"><img src="/shots/saas-landing/after/desktop-dark.webp" alt="Desktop, dark capture" width="1440" height="900" loading="lazy" decoding="async" /></span><span role="cell" class="cell cell--m"><img src="/shots/saas-landing/after/mobile-dark.webp" alt="Mobile, dark capture" width="390" height="844" loading="lazy" decoding="async" /></span></div>
          <p class="matrix__cap">Real captures: the SaaS landing page, after one run.</p>
        </div>
        <div>
          <h3 class="how__h">Eleven Dimensions, scored out of 10</h3>
          <ol class="dims">{DIMENSIONS.map((d) => <li>{d}</li>)}</ol>
          <h3 class="how__h how__h--gap">Placed on a Level first</h3>
          <ul class="levels">
            {levels.map((l) => (
              <li><span class="levels__n mono num">{l.n}</span><div><b>{l.name}</b> <span>{l.d}</span></div></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="laws" aria-labelledby="laws-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">The laws</p>
        <h2 id="laws-h">Twenty laws behind every score.</h2>
        <p class="lede">Taste isn't a vibe. Every critique finding and every fix traces back to one of these, and to the Lens that applies it. Twenty is too many to hold at once, so they come in five groups.</p>
      </div>
      <div class="laws">
        {lawGroups.map((g, gi) => (
          <details class="lawset" open={gi === 0}>
            <summary class="lawset__head">
              <span class="lawset__n mono num">{laws.filter((l) => l.group === g.id).length} laws</span>
              <h3>{g.name}</h3>
              <p>{g.d}</p>
            </summary>
            <ol class="lawset__list" style={`--cols:${laws.filter((l) => l.group === g.id).length}`} start={lawGroups.slice(0, gi).reduce((n, x) => n + laws.filter((l) => l.group === x.id).length, 0) + 1}>
              {laws.filter((l) => l.group === g.id).map((l) => (
                <li class="law">
                  <h4>{l.name}</h4>
                  <p class="law__says">{l.says}</p>
                  <p class="law__does">{l.does}</p>
                  <p class="law__lens mono">{l.lens}</p>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-h">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Install</p>
        <h2 id="install-h">Two lines, then <code>/pristine init</code>.</h2>
      </div>
      <div class="install">
        <div class="install__step">
          <h3>Claude Code</h3>
          <p>Add the marketplace, then install the plugin. Updates itself.</p>
          <Copy cmd="/plugin marketplace add maddhruv/pristine" wrap label="Copy Claude Code marketplace command" />
          <Copy cmd="/plugin install pristine@pristine" wrap label="Copy Claude Code install command" />
        </div>
        <div class="install__step">
          <h3>Codex</h3>
          <p>Same marketplace, from the Codex CLI.</p>
          <Copy cmd="codex plugin marketplace add maddhruv/pristine" wrap label="Copy Codex marketplace command" />
          <Copy cmd="codex plugin add pristine@pristine" wrap label="Copy Codex install command" />
        </div>
        <div class="install__step">
          <h3>GitHub Copilot</h3>
          <p>CLI and VS Code.</p>
          <Copy cmd="copilot plugin marketplace add maddhruv/pristine" wrap label="Copy Copilot marketplace command" />
          <Copy cmd="copilot plugin install pristine@pristine" wrap label="Copy Copilot install command" />
        </div>
        <div class="install__step">
          <h3>Any other agent</h3>
          <p>Copies the skill where your agents look for it.</p>
          <Copy cmd={install} wrap label="Copy install command" />
        </div>
      </div>
      <p class="install__next">Then, in your project: <code>/pristine init</code> to write <code>DESIGN.md</code>, and <code>/pristine</code> on whatever you're building.</p>
    </div>
  </section>
</Base>

<script>
  const root = document.documentElement;
  const mq = matchMedia("(prefers-color-scheme: dark)");
  const sync = () => {
    const dark = root.dataset.theme ? root.dataset.theme === "dark" : mq.matches;
    document.querySelectorAll<HTMLImageElement>("img[data-dark]").forEach((img) => {
      const src = dark ? img.dataset.dark! : img.dataset.light!;
      if (img.getAttribute("src") !== src) img.src = src;
    });
  };
  sync();
  mq.addEventListener("change", sync);
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
</script>

<style>
  .lead { padding-block: var(--s-7); }
  .lead__in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--s-7); align-items: end; }
  .lead__say, .lead__do { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  .lead h1 { font-size: var(--text-3xl); font-weight: 380; }
  .lead h1 em { font-style: italic; font-weight: 400; }
  .lead .lede { font-size: var(--text-md); }
  #examples { border-top: 0; padding-top: var(--s-5); }


  .rows { list-style: none; margin: 0 0 var(--s-8); padding: 0; border-top: 1px solid var(--ink); }
  .rows > li { border-bottom: 1px solid var(--rule); }
  .row summary { list-style: none; display: grid; grid-template-columns: 32px 130px minmax(0, 1fr) auto; gap: var(--s-4); align-items: baseline; padding-block: var(--s-4); cursor: pointer; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .row__n { font-size: var(--text-xs); color: var(--ink-3); }
  .row__name { font: italic 400 var(--text-xl)/1.2 var(--font-display); }
  .row__does { color: var(--ink-2); font-size: var(--text-sm); }
  .row[open] .row__does { color: var(--ink); }
  .row__badge { font-size: var(--text-xs); padding: 3px 7px; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink-2); white-space: nowrap; }
  .row__badge.is-ro { border-color: color-mix(in oklab, var(--ok) 40%, var(--rule)); color: var(--ok); }
  .row__more { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); padding: 0 0 var(--s-5) calc(32px + 130px + 2 * var(--s-4)); max-width: 860px; font-size: var(--text-sm); }
  .row__when { color: var(--ink-2); }
  .row__when .mono { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; margin-right: var(--s-2); color: var(--ink-3); }
  .row__out { margin: 0; padding-left: var(--s-5); color: var(--ink-2); display: grid; gap: var(--s-1); }

  @media (max-width: 960px) {
    .lead__in { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
            .row summary { grid-template-columns: 32px minmax(0, 1fr) auto; }
    .row__does { grid-column: 2 / -1; }
    .row__badge { grid-column: 3; grid-row: 1; }
    .row__more { padding-left: 0; }
  }
  @media (max-width: 640px) { .lead h1 { font-size: var(--text-2xl); } .lead { padding-block: var(--s-6) var(--s-5); } }
  .cmds__more { margin-top: var(--s-6); }
  .row__more a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 640px) {
    .chips li { padding: 0; }
    .chips a { display: flex; align-items: center; min-height: 44px; padding: 0 var(--s-3); }
  }
  #examples { padding-top: var(--s-7); }
  .chips a { color: inherit; text-decoration: none; }
  .chips a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
  @media (max-width: 960px) { .grid2 { grid-template-columns: minmax(0, 1fr); } }
  .panel { padding: var(--s-6); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); display: grid; gap: var(--s-3); align-content: start; }
  @media (max-width: 640px) { .panel { padding: var(--s-5); } }
  .panel h3 { font-size: var(--text-xl); }
  .panel h3 code { font-size: 0.85em; }
  .panel > p { color: var(--ink-2); font-size: var(--text-sm); }
  .panel__sub { margin-top: var(--s-4); }
  .routes { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .routes th { text-align: left; font: 500 var(--text-xs)/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .routes td { padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .routes td.mono { text-align: right; padding-left: var(--s-4); white-space: nowrap; }
  .routes th:last-child { text-align: right; }
  .targets { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3) var(--s-5); }
  .targets div { border-top: 1px solid var(--rule); padding-top: var(--s-2); min-width: 0; }
  .targets dt { font-weight: 600; font-size: var(--text-sm); }
  .targets dd { margin: 0; color: var(--ink-2); font-size: var(--text-xs); overflow-wrap: anywhere; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font-size: var(--text-xs); padding: 4px 8px; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink-2); }

  .how { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  @media (max-width: 960px) { .how { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); } }
  .matrix { display: grid; gap: var(--s-3); }
  .matrix__row { display: grid; grid-template-columns: 56px 1fr 0.42fr; gap: var(--s-3); align-items: start; }
  .matrix__row > [role=rowheader] { padding-top: var(--s-2); }
  .matrix__head span { font-size: var(--text-xs); color: var(--ink-3); }
  .matrix__row > .mono { font-size: var(--text-xs); color: var(--ink-2); }
  .cell { aspect-ratio: 1440 / 900; overflow: hidden; border: 1px solid var(--rule); border-radius: 8px; background: var(--surface-2); }
  .cell img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .matrix__cap { font-size: var(--text-xs); color: var(--ink-3); }
  .cell--m { aspect-ratio: 390 / 844; justify-self: start; width: 100%; }
  .how__h { font-size: var(--text-xl); margin-bottom: var(--s-4); }
  .how__h--gap { margin-top: var(--s-7); }
  .dims { margin: 0; padding: 0; list-style: none; counter-reset: d; columns: 2; column-gap: var(--s-6); font-size: var(--text-sm); }
  .dims li { counter-increment: d; padding: var(--s-2) 0; border-top: 1px solid var(--rule); break-inside: avoid; }
  .dims li::before { content: counter(d, decimal-leading-zero); font: 500 var(--text-xs) var(--font-mono); color: var(--ink-3); margin-right: var(--s-3); }
  .levels { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--s-3); }
  .levels li { display: grid; grid-template-columns: 40px 1fr; gap: var(--s-3); font-size: var(--text-sm); color: var(--ink-2); }
  .levels b { color: var(--ink); font-weight: 600; }
  .levels__n { font-size: var(--text-xl); line-height: 1.1; color: var(--ink); }
  @media (max-width: 420px) { .dims { columns: 1; } }

  .install { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5); }
  @media (max-width: 1100px) { .install { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .install { grid-template-columns: minmax(0, 1fr); } }
  .install__step { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); align-content: start; padding-top: var(--s-4); border-top: 1px solid var(--ink); min-width: 0; }
  .install__step h3 { font-size: var(--text-xl); }
  .install__step p { color: var(--ink-2); font-size: var(--text-sm); }
  .install__next { margin-top: var(--s-7); font-size: var(--text-lg); color: var(--ink-2); }
  .install__next code { color: var(--ink); }
  #install h2 code { font-family: var(--font-display); font-style: italic; font-size: 0.95em; }


  #built h2 code { font-family: var(--font-display); font-style: italic; font-size: 0.95em; }
  .sprout__hero { position: relative; display: block; aspect-ratio: 1440 / 640; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius); margin-bottom: var(--s-6); }
  .sprout__hero img { display: block; width: 100%; height: auto; }
  .sprout__visit { position: absolute; right: var(--s-3); bottom: var(--s-3); padding: 6px 10px; border-radius: var(--radius-sm); font-size: var(--text-sm); background: var(--ink); color: var(--on-ink); }
  @media (max-width: 640px) { .sprout__visit { right: var(--s-2); bottom: var(--s-2); padding: 3px 6px; font-size: var(--text-xs); } }
  .sprout { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-6) var(--s-5); }
  .sprout__card { display: grid; gap: var(--s-3); text-decoration: none; color: inherit; border-radius: var(--radius); }
  .sprout__shot { display: block; aspect-ratio: 846 / 560; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius-sm); }
  .sprout__shot img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.2); transform-origin: 50% 40%; transition: transform var(--dur-reveal) var(--ease-out); }
  .sprout__meta { display: grid; gap: var(--s-1); font-size: var(--text-sm); color: var(--ink-2); }
  .sprout__meta b { font-size: var(--text-md); color: var(--ink); font-weight: 600; }
  @media (hover: hover) and (pointer: fine) {
    .sprout__card:hover .sprout__shot img { transform: scale(1.25); }
    .sprout__card:hover b, .sprout__hero:hover .sprout__visit { text-decoration: underline; text-underline-offset: 3px; }
  }

  .laws { display: grid; gap: var(--s-7); counter-reset: law; }
  .lawset { border-top: 1px solid var(--ink); }
  .lawset__head { list-style: none; cursor: pointer; display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; align-items: baseline; gap: var(--s-2) var(--s-6); padding-block: var(--s-4); border-radius: var(--radius-sm); }
  .lawset__head::-webkit-details-marker { display: none; }
