            <article class="cc" id="c-tooltip" data-name="tooltip hint">
              <div class="cc-stage center">
                <div style="display:grid;justify-items:center;gap:10px;position:relative">
                  <span class="tip tip-pinned" style="position:relative">Copy ID <kbd>⌘C</kbd></span>
                  <span class="btn btn-icon" aria-hidden="true"><svg class="icon" aria-hidden="true"><use href="#i-copy" /></svg></span>
                </div>
              </div>
              <div class="cc-foot"><h4><a href="#c-tooltip">Tooltip</a></h4><span class="meta">500ms · then instant</span><p>Labels and shortcuts only, never content.</p></div>
            </article>
            <article class="cc" id="c-tabs" data-name="tabs navigation">
              <div class="cc-stage">
                <div class="panel tabs" style="padding:4px 16px 16px">
                  <div role="tablist" aria-label="Project">
                    <button role="tab" type="button" id="tab-1" aria-selected="true" aria-controls="tp-1">Overview</button>
                    <button role="tab" type="button" id="tab-2" aria-selected="false" aria-controls="tp-2" tabindex="-1">Activity</button>
                    <button role="tab" type="button" id="tab-3" aria-selected="false" aria-controls="tp-3" tabindex="-1">Settings</button>
                  </div>
                  <div role="tabpanel" id="tp-1" aria-labelledby="tab-1" tabindex="0">atlas-web serves the marketing site from Frankfurt. Last deploy took 48 s and passed all 212 checks.</div>
                  <div role="tabpanel" id="tp-2" aria-labelledby="tab-2" tabindex="0" hidden>Ines Okafor deployed <code>main@4f9c2e1</code> · 12 min ago</div>
                  <div role="tabpanel" id="tp-3" aria-labelledby="tab-3" tabindex="0" hidden>Build command: <code>pnpm build</code> · Output: <code>dist</code> · Node 22</div>
                </div>
              </div>
              <div class="cc-foot"><h4><a href="#c-tabs">Tabs</a></h4><span class="meta">Arrow keys · Home · End</span><p>One tab stop; arrows move between tabs.</p></div>
            </article>
          </div>
        </div>

        <div class="cat" data-cat>
          <h3>Data display <span>3</span></h3>
          <div class="grid">
            <article class="cc span3" id="c-card" data-name="project card truncation">
              <div class="cc-stage">
                <div class="pcards">
                  <div class="panel pc">
                    <div class="pc-top"><span class="pc-name">atlas-web</span><span class="badge" data-tone="ok"><Status state="passed" size="sm" label="" />Deployed</span></div>
                    <span class="pc-env">Production · 12 min ago</span>
                    <div class="pc-stats"><span><b>1,284</b> req/min</span><span>Frankfurt</span></div>
                  </div>
                  <div class="panel pc">
                    <div class="pc-top"><span class="pc-name" title="northwind-industries-holdings-customer-portal-staging">northwind-industries-holdings-customer-portal-staging</span><span class="badge" data-tone="err"><Status state="failed" size="sm" label="" />Failed</span></div>
                    <span class="pc-env">Staging · 3 h ago · Build exited with code 1</span>
                    <div class="pc-stats"><span><b>0</b> req/min</span><span>Virginia</span></div>
                  </div>
                  <div class="panel pc">
                    <div class="pc-top"><span class="pc-name">analytics-api</span><span class="badge" data-tone="run"><Status state="running" size="sm" label="" />Building</span></div>
                    <span class="pc-env">Production · 2 days ago</span>
                    <div class="pc-stats"><span><b>312</b> req/min</span><span>Singapore</span></div>
                  </div>
                </div>
              </div>
              <div class="cc-foot"><h4><a href="#c-card">Project card</a></h4><span class="meta">Truncates, never wraps the badge</span><p>A 52-character name ends in an ellipsis and keeps its full text on hover.</p></div>
            </article>
            <article class="cc" id="c-avatar" data-name="avatar group">
              <div class="cc-stage center">
                <div class="av-demo">
                  <span class="lg">Deployed atlas-web this week</span>
