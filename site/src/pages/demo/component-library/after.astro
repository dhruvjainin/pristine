                  <li><span class="av c3">AW</span><div style="min-width:0"><div class="n">Aleksandra Wiśniewska-Kowalczyk</div><div class="e">bartholomew.fitzgerald@northwind-industries-holdings.example.com</div></div><span class="role">Owner</span></li>
                  <li><span class="av c2">IO</span><div style="min-width:0"><div class="n">Ines Okafor</div><div class="e">ines@northwind.com</div></div><span class="role">Admin</span></li>
                  <li><span class="av">J</span><div style="min-width:0"><div class="n">J</div><div class="e">j@northwind.com</div></div><span class="role">Viewer</span></li>
                </ul>
              </div>
              <div class="cc-foot"><h4><a href="#c-list">Member list</a></h4><span class="meta">One-letter to 60-character names</span><p>Roles stay aligned whatever the name length.</p></div>
