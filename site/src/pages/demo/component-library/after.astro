  <footer class="foot-site" id="changelog">
    <div class="wrap">
      <span>Grain UI 2.4.0 · MIT · 4 radii, 2 shadows, 3 durations, 1 accent</span>
      <nav aria-label="Footer">
        <a href="/demo/docs-article/after">Docs</a>
        <a href="#components">Components</a>
        <a href="#status">Changelog</a>
        <a href="#main">GitHub</a>
      </nav>
    </div>
  </footer>

  <dialog class="dlg" id="dlg-delete" aria-labelledby="dlg-title" aria-describedby="dlg-desc">
    <form method="dialog" id="dlg-form">
      <h2 id="dlg-title">Delete atlas-web?</h2>
      <p id="dlg-desc">This removes 14 deployments and 3 domains. It can’t be undone.</p>
      <div class="field">
        <label for="dlg-input">Type <b>atlas-web</b> to confirm</label>
        <input class="input" id="dlg-input" autocomplete="off" spellcheck="false" />
      </div>
      <div class="foot">
        <button class="btn" value="cancel" autofocus>Cancel</button>
        <button class="btn btn-danger" value="delete" id="dlg-confirm" disabled>Delete project</button>
      </div>
    </form>
  </dialog>

  <div class="toaster" id="toaster" role="region" aria-label="Notifications"><div aria-live="polite" id="toast-live" style="display:contents"></div></div>

  <template id="tpl-err"><Status state="failed" size="sm" label="" /></template>
  <template id="tpl-toast">
    <div class="toast">
      <Status state="passed" label="" />
      <div><b></b><span class="body"></span></div>
      <button class="btn btn-ghost btn-sm btn-icon x" type="button" aria-label="Dismiss"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg></button>
    </div>
  </template>

  <script is:inline>
  (() => {
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const NAMES = { queued: "Queued", running: "Running", passed: "Passed", warning: "Passed with warnings", failed: "Failed", needs: "Needs you", canceled: "Canceled", skipped: "Skipped" };

    function setStatus(el, state, value, label) {
      if (!el) return;
      const changed = el.dataset.state !== state;
      el.dataset.state = state;
      const det = state === "running" && value != null;
      el.toggleAttribute("data-determinate", det);
      if (det) {
        const on = Math.floor((value / 100) * 8);
        $$(".segs path", el).forEach((p, i) => { p.classList.toggle("on", i < on); p.classList.toggle("now", i === on); });
      }
      if (el.getAttribute("role") === "img") el.setAttribute("aria-label", label || NAMES[state]);
      if (changed) { el.removeAttribute("data-changed"); void el.offsetWidth; el.setAttribute("data-changed", ""); }
    }

    /* ---------- toasts ---------- */
    const live = $("#toast-live");
    const tpl = $("#tpl-toast");
    function toast({ state = "passed", title, body = "", actions = [] }) {
      const node = tpl.content.firstElementChild.cloneNode(true);
      setStatus($(".st", node), state);
      $("b", node).textContent = title;
      $(".body", node).textContent = body;
      if (state === "failed") node.setAttribute("role", "alert");
      if (actions.length) {
        const row = document.createElement("div");
        row.className = "actions";
        actions.forEach(([label, fn]) => {
          const b = document.createElement("button");
          b.type = "button"; b.className = "btn btn-sm"; b.textContent = label;
          b.addEventListener("click", () => { fn && fn(); close(); });
          row.append(b);
        });
        node.append(row);
      }
      let timer, closed = false;
      const close = () => {
        if (closed) return; closed = true; clearTimeout(timer);
        if (reduce.matches) { node.remove(); return; }
        node.classList.add("out");
        node.addEventListener("animationend", () => node.remove(), { once: true });
      };
      const arm = () => { clearTimeout(timer); timer = setTimeout(close, 5000); };
      node.addEventListener("pointerenter", () => clearTimeout(timer));
      node.addEventListener("pointerleave", arm);
      node.addEventListener("focusin", () => clearTimeout(timer));
      node.addEventListener("focusout", (e) => { if (!node.contains(e.relatedTarget)) arm(); });
      $(".x", node).addEventListener("click", close);
      live.append(node);
      while (live.children.length > 3) live.firstElementChild.remove();
      arm();
    }

    /* ---------- copy ---------- */
    $$("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); } catch {}
      const use = $("use", b);
      if (use) { use.setAttribute("href", "#i-check"); setTimeout(() => use.setAttribute("href", "#i-copy"), 1500); }
      toast({ title: "Copied", body: b.dataset.copy });
    }));

    /* ---------- live deploy run ---------- */
    const run = $("#run");
    const steps = Object.fromEntries($$(".step", run).map((li) => [li.dataset.step, li]));
    const badge = $("#run-badge");
    const timeEl = $("#run-time");
    const runLive = $("#run-live");
    const failToggle = $("#fail-toggle");
    const cancelBtn = $("#run-cancel");
    const TICK = 120, TOTAL = 212;
    let sec = 52, checks = 140, phase = "checks", phaseSec = 9, loop = null;
    const BADGE = { building: ["run", "running", "Building"], waiting: ["need", "needs", "Waiting for approval"], live: ["ok", "passed", "Deployed"], failed: ["err", "failed", "Failed"], canceled: ["", "canceled", "Canceled"], held: ["", "canceled", "On hold"] };

    const fmt = (n) => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, "0")}`;
    function setBadge(k) {
      const [tone, st, text] = BADGE[k];
      tone ? badge.dataset.tone = tone : delete badge.dataset.tone;
      setStatus($(".st", badge), st);
      const t = $("span:last-child", badge);
      t.textContent = text; t.classList.remove("swap"); void t.offsetWidth; t.classList.add("swap");
    }
    function setStep(name, state, meta, value, label) {
      const li = steps[name];
      li.dataset.s = state;
      setStatus($(".st", li), state, value, label);
      if (meta != null) $("[data-meta]", li).textContent = meta;
    }
    const say = (m) => { runLive.textContent = m; };
    const order = ["install", "build", "checks", "upload", "promote"];
    const DUR = { install: 12, build: 31, upload: 6 };

    function startPhase(name) {
      phase = name; phaseSec = 0;
      if (name === "checks") { checks = 0; setStep("checks", "running", `0 of ${TOTAL}`, 0, `Running, 0 of ${TOTAL} checks`); $("[data-cmd]", steps.checks).textContent = "Unit, visual and accessibility suites"; }
      else if (name === "promote") {
        stop(); setStep("promote", "needs", "Needs you"); setBadge("waiting");
        cancelBtn.disabled = false;
        say("Checks passed. Promote to production needs your approval.");
      } else setStep(name, "running", "0s");
    }
    function finish(name) {
      const meta = name === "checks" ? `${phaseSec}s` : `${DUR[name]}s`;
      setStep(name, "passed", meta);
      startPhase(order[order.indexOf(name) + 1]);
    }
    function tick() {
      sec++; phaseSec++;
      timeEl.textContent = fmt(sec);
      if (phase === "checks") {
        const failing = failToggle.checked;
        checks = Math.min(TOTAL, checks + 11);
        if (checks >= TOTAL) {
          if (failing) return fail();
          return finish("checks");
        }
        setStep("checks", "running", `${checks} of ${TOTAL}`, Math.round((checks / TOTAL) * 100), `Running, ${checks} of ${TOTAL} checks`);
      } else if (DUR[phase]) {
        if (phaseSec >= DUR[phase]) return finish(phase);
        $("[data-meta]", steps[phase]).textContent = `${phaseSec}s`;
      }
    }
    function stop() { clearInterval(loop); loop = null; }
    function go() { stop(); loop = setInterval(tick, TICK); cancelBtn.disabled = false; }
    function fail() {
      stop();
      setStep("checks", "failed", `3 of ${TOTAL} failed`);
      $("[data-cmd]", steps.checks).innerHTML = "<code>invoice.test.ts</code> rounds totals above €10,000, and 2 more";
      setStep("upload", "skipped", "Skipped"); setStep("promote", "skipped", "Skipped");
      setBadge("failed"); cancelBtn.disabled = true;
      say("Deploy failed. 3 of 212 checks failed.");
      toast({ state: "failed", title: "atlas-web deploy failed", body: "3 of 212 checks failed in invoice.test.ts. Production is unchanged.", actions: [["View logs"], ["Redeploy", redeploy]] });
    }
    function cancel() {
      stop();
      const cur = order.find((n) => ["running", "needs"].includes(steps[n].dataset.s));
      if (!cur) return;
      setStep(cur, "canceled", "Canceled");
      order.slice(order.indexOf(cur) + 1).forEach((n) => setStep(n, "skipped", "Skipped"));
      setBadge("canceled"); cancelBtn.disabled = true;
      say("Run canceled.");
      toast({ state: "canceled", title: "Deploy canceled", body: "Production still serves the previous build." });
    }
    function redeploy() {
      stop(); sec = 0; timeEl.textContent = fmt(0);
      order.forEach((n) => setStep(n, "queued", "Queued"));
      setBadge("building"); say("Redeploying atlas-web.");
      startPhase("install"); go();
    }
    run.addEventListener("click", (e) => {
      const act = e.target.closest("[data-act]")?.dataset.act;
      if (act === "cancel") cancel();
      if (act === "redeploy") redeploy();
      if (act === "approve") {
        setStep("promote", "running", "Swapping");
        setTimeout(() => {
          setStep("promote", "passed", "2s"); setBadge("live"); cancelBtn.disabled = true;
          say("atlas-web is live.");
          toast({ title: "atlas-web is live", body: "main@4f9c2e1 is serving production in Frankfurt." });
        }, 900);
      }
      if (act === "hold") {
        setStep("promote", "canceled", "Held"); setBadge("held"); cancelBtn.disabled = true;
        say("Promotion on hold.");
        toast({ state: "canceled", title: "Held before production", body: "The preview stays live at atlas-web-4f9c2e1.grain.app." });
      }
    });
    setTimeout(go, 900);

    /* ---------- status lab ---------- */
    const labMark = $("#lab-mark");
    $$('input[name="lab-state"]').forEach((r) => r.addEventListener("change", () => {
      setStatus(labMark, r.value);
      $("#lab-name").textContent = r.dataset.name;
      $("#lab-desc").textContent = r.dataset.desc;
      $("#lab-code").textContent = `"${r.value}"`;
    }));

    /* ---------- filter ---------- */
    const filter = $("#filter");
    const cards = $$(".cc[data-name]");
    const cats = $$("[data-cat]");
    const count = $("#count");
    const noMatch = $("#no-match");
    function applyFilter() {
      const q = filter.value.trim().toLowerCase();
      let n = 0;
      cards.forEach((c) => {
        const hit = !q || c.dataset.name.includes(q) || $("h4", c).textContent.toLowerCase().includes(q);
        c.hidden = !hit; if (hit) n++;
      });
      cats.forEach((cat) => { cat.hidden = !$$(".cc", cat).some((c) => !c.hidden); });
      count.textContent = `${n} shown`;
      noMatch.hidden = n > 0;
      $("#nm-q").textContent = filter.value.trim();
    }
    filter.addEventListener("input", applyFilter);
    filter.addEventListener("keydown", (e) => { if (e.key === "Escape" && filter.value) { filter.value = ""; applyFilter(); } });
    $("#clear-filter").addEventListener("click", () => { filter.value = ""; applyFilter(); filter.focus(); });

    /* ---------- tabs ---------- */
    $$('[role="tablist"]').forEach((list) => {
      const tabs = $$('[role="tab"]', list);
      const select = (t) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute("aria-selected", on); x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
        });
        t.focus();
      };
      list.addEventListener("click", (e) => { const t = e.target.closest('[role="tab"]'); if (t) select(t); });
      list.addEventListener("keydown", (e) => {
        const i = tabs.indexOf(document.activeElement);
        const k = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (k == null) return;
        e.preventDefault(); select(tabs[(k + tabs.length) % tabs.length]);
      });
    });

    /* ---------- tooltips: 500ms first, instant while warm ---------- */
    const group = $("#tips");
    let warmT, openT, cool;
    $$(".tip-wrap", group).forEach((w) => {
      w.addEventListener("pointerenter", () => {
        clearTimeout(cool);
        const show = () => { $$(".tip-wrap", group).forEach((x) => x.classList.toggle("open", x === w)); group.dataset.warm = ""; };
        group.hasAttribute("data-warm") ? show() : (openT = setTimeout(show, 500));
      });
      w.addEventListener("pointerleave", () => {
        clearTimeout(openT); w.classList.remove("open");
        cool = setTimeout(() => delete group.dataset.warm, 300);
      });
    });

    /* ---------- toast demo & save ---------- */
    $("#toast-demo").addEventListener("click", () => toast({ title: "atlas-web deleted", body: "14 deployments and 3 domains removed.", actions: [["Undo", () => toast({ title: "atlas-web restored", body: "All 14 deployments are back." })]] }));
    const save = $("#save-btn");
    save.addEventListener("click", () => {
      if (save.getAttribute("aria-disabled") === "true") return;
      save.style.width = save.offsetWidth + "px";
      save.setAttribute("aria-disabled", "true");
      save.innerHTML = '<span class="spinner" aria-hidden="true"></span>Saving';
      setTimeout(() => {
        save.innerHTML = '<svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Saved';
        save.removeAttribute("aria-disabled");
        setTimeout(() => { save.textContent = save.dataset.label; save.style.width = ""; }, 1400);
      }, 1100);
    });

    /* ---------- validation: errors on blur, cleared as soon as fixed ---------- */
    function validator(input, help, check, okText) {
      const base = help.innerHTML;
      const render = () => {
        const msg = check(input.value.trim());
        input.setAttribute("aria-invalid", msg ? "true" : "false");
        help.classList.toggle("err", !!msg);
        help.innerHTML = msg ? `${$("#tpl-err").innerHTML}<span>${msg}</span>` : (okText ? `<span>${okText}</span>` : base);
      };
      input.addEventListener("blur", render);
      input.addEventListener("input", () => { if (input.getAttribute("aria-invalid") === "true") render(); });
    }
    validator($("#f-name"), $("#f-name-h"), (v) => !v ? "Name your project to give it a URL" : /^[a-z0-9-]+$/.test(v) ? "" : `Use lowercase letters, numbers and hyphens, like “${v.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "atlas-web"}”`);
    validator($("#f-mail"), $("#f-mail-h"), (v) => !v ? "Invoices need somewhere to go" : !v.includes("@") ? "Add an @, like leo@northwind.com" : /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(v) ? "" : `Add the domain, like ${v.split("@")[0]}@northwind.com`, "Invoices go here on the 1st");

    /* ---------- dialog ---------- */
    const dlg = $("#dlg-delete");
    let opener = null;
    const supportsCommand = "command" in HTMLButtonElement.prototype;
    $$("[data-open]").forEach((b) => b.addEventListener("click", () => { opener = b; if (!supportsCommand) dlg.showModal(); }));
    const dIn = $("#dlg-input"), dOk = $("#dlg-confirm");
    dIn.addEventListener("input", () => { dOk.disabled = dIn.value.trim() !== "atlas-web"; });
    dlg.addEventListener("close", () => {
      if (dlg.returnValue === "delete") toast({ title: "atlas-web deleted", body: "14 deployments and 3 domains removed.", actions: [["Undo", () => toast({ title: "atlas-web restored", body: "All 14 deployments are back." })]] });
      dIn.value = ""; dOk.disabled = true; dlg.returnValue = "";
      opener?.focus();
    });
  })();
  </script>

</body>
