---
import Frame from "../../../components/demo/directions/Frame.astro";
const counts = [1, 3, 6, 12];
const plans = [
  { id: "starter", name: "Starter", price: 12, note: "1 account included" },
  { id: "pro", name: "Pro", price: 28, note: "3 accounts included" },
  { id: "business", name: "Business", price: 56, note: "Unlimited accounts" },
];
const fit: Record<number, string> = { 1: "starter", 3: "pro", 6: "pro", 12: "business" };
---
<Frame title="Direction B: Fit">
<style>
  header { display: grid; gap: 8px; margin-bottom: 24px; }
  fieldset { border: 0; padding: 0; margin: 0 0 24px; display: grid; gap: 8px; }
  legend { font-weight: 600; padding: 0; margin-bottom: 8px; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opts input { position: absolute; opacity: 0; }
  .opts label { display: inline-flex; align-items: center; justify-content: center; min-width: 56px; min-height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); cursor: pointer; font-variant-numeric: tabular-nums; }
  .opts input:checked + label { border-color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .plans { display: grid; gap: 12px; }
  .plan { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; align-items: center; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .plan h2 { font-size: 1rem; font-weight: 600; }
  .plan .note { color: var(--ink-3); font-size: 0.875rem; }
  .plan .price { font: 500 1.5rem/1 "Fraunces Variable", serif; grid-row: 1 / span 2; grid-column: 2; }
  .fit { display: none; grid-column: 1 / -1; margin-top: 8px; }
  .fit b { display: block; margin-bottom: 8px; color: var(--accent); }
  body:has(#n1:checked) [data-p="starter"] { border: 2px solid var(--accent); padding: 15px; }
  body:has(#n1:checked) [data-p="starter"] .fit { display: block; }
  body:has(#n3:checked) [data-p="pro"] { border: 2px solid var(--accent); padding: 15px; }
  body:has(#n3:checked) [data-p="pro"] .fit { display: block; }
  body:has(#n6:checked) [data-p="pro"] { border: 2px solid var(--accent); padding: 15px; }
  body:has(#n6:checked) [data-p="pro"] .fit { display: block; }
  body:has(#n12:checked) [data-p="business"] { border: 2px solid var(--accent); padding: 15px; }
  body:has(#n12:checked) [data-p="business"] .fit { display: block; }
</style>
<header>
  <p class="eyebrow">Ledgerline pricing</p>
  <h1>Pay for the setup you actually have.</h1>
  <p class="lede">Tell us how many bank accounts you connect. We show the plan that costs least.</p>
</header>
<fieldset>
  <legend>Bank accounts</legend>
  <div class="opts">
    {counts.map((n) => (<><input type="radio" name="n" id={`n${n}`} checked={n === 3} /><label for={`n${n}`}>{n}</label></>))}
  </div>
</fieldset>
<div class="plans">
  {plans.map((p) => (
    <article class="plan" data-p={p.id}>
      <h2>{p.name}</h2>
      <span class="price num">${p.price}<small style="font:400 .8125rem 'Inter Variable',sans-serif;color:var(--ink-3)">/mo</small></span>
      <p class="note">{p.note}</p>
      <div class="fit"><b>Cheapest for your setup</b><a class="btn" href="#">Start 30 days free</a></div>
    </article>
  ))}
</div>
</Frame>
