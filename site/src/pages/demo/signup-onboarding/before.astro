---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Fieldnote - Sign Up</title>
</head>
<body>
  <header class="appbar">
    <div class="toolbar">
      <div class="logo">Fieldnote</div>
      <nav class="links">
        <a href="#">FEATURES</a>
        <a href="#">PRICING</a>
        <a href="#">LOGIN</a>
      </nav>
    </div>
  </header>

  <main class="container" id="signup">
    <span class="chip">New: AI-powered summaries</span>
    <h1>Supercharge your meetings</h1>
    <p class="sub">The all-in-one, seamless note-taking platform for next-gen teams. Join thousands of happy users today!</p>

    <div class="paper">
      <ol class="stepper" aria-label="Step 1 of 4">
        <li class="step active"><span class="circle">1</span><span class="step-label">Account</span></li>
        <li class="step"><span class="circle">2</span><span class="step-label">Workspace</span></li>
        <li class="step"><span class="circle">3</span><span class="step-label">Invite team</span></li>
        <li class="step"><span class="circle">4</span><span class="step-label">Finish</span></li>
      </ol>
      <h2>Create your account</h2>
      <form id="signup-form">
        <div class="row">
          <div class="field"><input type="text" id="name" placeholder=" " required /><label for="name">Full name *</label></div>
          <div class="field"><input type="text" id="company" placeholder=" " required /><label for="company">Company name *</label></div>
        </div>
        <div class="field"><input type="tel" id="phone" placeholder=" " required /><label for="phone">Phone number *</label></div>
        <div class="field"><input type="text" id="email" placeholder=" " required /><label for="email">Email *</label></div>
        <div class="field"><input type="password" id="pw" placeholder=" " required /><label for="pw">Password *</label></div>
        <div class="field"><input type="password" id="pw2" placeholder=" " required /><label for="pw2">Confirm password *</label></div>
        <div class="err" id="err"></div>
        <label class="consent"><input type="checkbox" checked /> Yes! Send me tips, special offers and partner promotions</label>
        <button type="submit" class="btn contained full">Submit</button>
      </form>
      <p class="caption">Already have an account? <a href="#">Login</a></p>
    </div>
  </main>

  <section class="dash" id="dashboard">
    <aside class="drawer">
      <div class="logo">Fieldnote</div>
      <hr />
      <a class="active" href="#">Dashboard</a>
      <a href="#">My Notes</a>
      <a href="#">Team</a>
      <a href="#">Meetings</a>
      <a href="#">Settings</a>
    </aside>
    <div class="main">
      <h2>Dashboard</h2>
      <div class="kpis">
        <div class="kpi"><div class="kpi-label">Total Notes</div><div class="kpi-num">0</div></div>
        <div class="kpi"><div class="kpi-label">Team Members</div><div class="kpi-num">1</div></div>
        <div class="kpi"><div class="kpi-label">Meetings</div><div class="kpi-num">0</div></div>
      </div>
      <div class="empty">
        <h3>No notes yet</h3>
        <p>Create your first note to get started!</p>
        <button class="btn contained">+ New Note</button>
      </div>
    </div>
  </section>

  <dialog id="welcome">
    <h2>Welcome to Fieldnote!</h2>
    <p>Here's everything you can do:</p>
    <ul>
      <li>Create beautiful notes</li>
      <li>Invite your whole team</li>
      <li>Organize with tags &amp; folders</li>
      <li>Search across everything</li>
      <li>Get AI-powered summaries</li>
      <li>Sync with your calendar</li>
    </ul>
    <div class="actions">
      <button class="btn text" id="nope">No thanks, I prefer messy notes</button>
      <button class="btn contained" id="go">Let's go!</button>
    </div>
  </dialog>

  <script>
    const form = document.getElementById("signup-form") as HTMLFormElement;
    const err = document.getElementById("err")!;
    const pw = document.getElementById("pw") as HTMLInputElement;
    const pw2 = document.getElementById("pw2") as HTMLInputElement;
    const dash = document.getElementById("dashboard")!;
    const hero = document.getElementById("signup")!;
    const dlg = document.getElementById("welcome") as HTMLDialogElement;
    dash.style.display = "none";

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = pw.value;
      if (v.length < 10 || !/[A-Z]/.test(v) || !/[0-9]/.test(v) || !/[^A-Za-z0-9]/.test(v)) {
        err.textContent = "Invalid password. Password must be at least 10 characters and contain an uppercase letter, a number and a special character.";
        pw.value = ""; pw2.value = "";
        return;
      }
      if (v !== pw2.value) {
        err.textContent = "Passwords do not match.";
        pw.value = ""; pw2.value = "";
        return;
      }
      hero.style.display = "none";
      dash.style.display = "flex";
      dlg.showModal();
    });
    document.getElementById("go")!.addEventListener("click", () => dlg.close());
    document.getElementById("nope")!.addEventListener("click", () => dlg.close());
  </script>

  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Roboto, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif; background: #f5f5f5; color: rgba(0,0,0,0.87); font-size: 16px; line-height: 1.5; letter-spacing: 0.00938em; }
    a { color: #1976d2; text-decoration: none; }
    button { font-family: inherit; }
    *:focus { outline: none; }

    .appbar { background: #1976d2; color: #fff; box-shadow: 0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12); }
    .toolbar { min-height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; }
    .appbar .logo { font-size: 20px; font-weight: 500; letter-spacing: 0.0075em; }
    .links a { color: #fff; font-size: 14px; font-weight: 500; letter-spacing: 0.02857em; padding: 6px 8px; margin-left: 8px; }

    .container { max-width: 600px; margin: 0 auto; padding: 48px 16px 64px; text-align: center; }
    .chip { display: inline-block; border: 1px solid rgba(25,118,210,0.5); color: #1976d2; border-radius: 16px; padding: 3px 10px; font-size: 13px; margin-bottom: 16px; }
    .container h1 { font-size: 3rem; font-weight: 400; line-height: 1.167; margin-bottom: 8px; }
    .sub { color: rgba(0,0,0,0.6); font-size: 1rem; margin: 0 auto 32px; max-width: 520px; }

    .paper { background: #fff; border-radius: 4px; padding: 32px; text-align: left; max-width: 500px; margin: 0 auto; box-shadow: 0 3px 1px -2px rgba(0,0,0,0.2), 0 2px 2px 0 rgba(0,0,0,0.14), 0 1px 5px 0 rgba(0,0,0,0.12); }

    .stepper { list-style: none; display: flex; margin-bottom: 24px; }
    .step { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .step + .step::before { content: ""; position: absolute; top: 12px; left: calc(-50% + 20px); right: calc(50% + 20px); border-top: 1px solid #bdbdbd; }
    .circle { width: 24px; height: 24px; border-radius: 50%; background: rgba(0,0,0,0.38); color: #fff; font-size: 12px; display: grid; place-items: center; }
    .step.active .circle { background: #1976d2; }
    .step-label { font-size: 14px; color: rgba(0,0,0,0.6); text-align: center; line-height: 1.43; }
    .step.active .step-label { color: rgba(0,0,0,0.87); font-weight: 500; }

    .paper h2 { font-size: 1.5rem; font-weight: 400; line-height: 1.334; margin-bottom: 16px; }
    .row { display: flex; gap: 16px; }
    .row .field { flex: 1; min-width: 0; }
    .field { position: relative; margin-bottom: 16px; }
    .field input { width: 100%; height: 56px; padding: 16.5px 14px; font: inherit; color: rgba(0,0,0,0.87); border: 1px solid rgba(0,0,0,0.23); border-radius: 4px; background: transparent; }
    .field input:hover { border-color: rgba(0,0,0,0.87); }
    .field input:focus { border: 2px solid #1976d2; padding: 15.5px 13px; }
    .field label { position: absolute; left: 14px; top: 16px; color: rgba(0,0,0,0.6); pointer-events: none; transform-origin: left top; transition: transform 200ms cubic-bezier(0,0,0.2,1), color 200ms; background: #fff; padding: 0 4px; margin-left: -4px; max-width: calc(100% - 24px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .field input:focus + label,
    .field input:not(:placeholder-shown) + label { transform: translateY(-25px) scale(0.75); max-width: calc(133% - 24px); }
    .field input:focus + label { color: #1976d2; }
    .err { color: #d32f2f; font-size: 0.75rem; margin: -8px 0 8px 14px; letter-spacing: 0.03333em; }
    .consent { display: flex; gap: 8px; align-items: center; font-size: 0.75rem; color: rgba(0,0,0,0.6); margin: 0 0 16px; letter-spacing: 0.03333em; }
    .consent input { accent-color: #1976d2; width: 18px; height: 18px; }

    .btn { border: none; border-radius: 4px; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.02857em; text-transform: uppercase; line-height: 1.75; padding: 6px 16px; cursor: pointer; transition: background-color 250ms cubic-bezier(0.4,0,0.2,1), box-shadow 250ms cubic-bezier(0.4,0,0.2,1); }
    .btn.contained { background: #1976d2; color: #fff; box-shadow: 0 3px 1px -2px rgba(0,0,0,0.2), 0 2px 2px 0 rgba(0,0,0,0.14), 0 1px 5px 0 rgba(0,0,0,0.12); }
    .btn.contained:hover { background: #1565c0; box-shadow: 0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12); }
    .btn.text { background: none; color: #1976d2; padding: 6px 8px; }
    .btn.text:hover { background: rgba(25,118,210,0.04); }
    .btn.full { width: 100%; }
    .caption { font-size: 0.75rem; color: rgba(0,0,0,0.6); text-align: center; margin-top: 16px; letter-spacing: 0.03333em; }

    .dash { display: flex; min-height: 100vh; }
    .drawer { width: 240px; background: #fff; border-right: 1px solid rgba(0,0,0,0.12); display: flex; flex-direction: column; padding: 8px 0; }
    .drawer .logo { font-size: 20px; font-weight: 500; padding: 12px 16px 16px; color: #1976d2; }
    .drawer hr { border: none; border-top: 1px solid rgba(0,0,0,0.12); margin-bottom: 8px; }
    .drawer a { color: rgba(0,0,0,0.87); padding: 8px 16px; font-size: 1rem; }
    .drawer a:hover { background: rgba(0,0,0,0.04); }
    .drawer a.active { background: rgba(25,118,210,0.08); }
    .main { flex: 1; padding: 24px; }
    .main h2 { font-size: 2.125rem; font-weight: 400; line-height: 1.235; margin-bottom: 24px; }
    .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 24px; }
    .kpi { background: #fff; border-radius: 4px; padding: 16px; box-shadow: 0 2px 1px -1px rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.14), 0 1px 3px 0 rgba(0,0,0,0.12); }
    .kpi-label { font-size: 0.875rem; color: rgba(0,0,0,0.6); }
    .kpi-num { font-size: 3rem; font-weight: 400; color: #1976d2; line-height: 1.167; }
    .empty { background: #fff; border-radius: 4px; padding: 48px 16px; text-align: center; box-shadow: 0 2px 1px -1px rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.14), 0 1px 3px 0 rgba(0,0,0,0.12); }
    .empty h3 { font-size: 1.25rem; font-weight: 500; }
    .empty p { color: rgba(0,0,0,0.6); font-size: 0.875rem; margin: 4px 0 16px; }

    dialog { margin: auto; border: none; border-radius: 4px; padding: 0; max-width: 444px; width: calc(100% - 64px); box-shadow: 0 11px 15px -7px rgba(0,0,0,0.2), 0 24px 38px 3px rgba(0,0,0,0.14), 0 9px 46px 8px rgba(0,0,0,0.12); }
    dialog::backdrop { background: rgba(0,0,0,0.5); }
    dialog h2 { font-size: 1.25rem; font-weight: 500; padding: 16px 24px; }
    dialog p { color: rgba(0,0,0,0.6); padding: 0 24px 8px; }
    dialog ul { padding: 0 24px 8px 48px; color: rgba(0,0,0,0.6); }
    dialog li { padding: 2px 0; }
    .actions { display: flex; justify-content: flex-end; gap: 8px; padding: 8px; }

    @media (max-width: 640px) {
      .toolbar { min-height: 56px; padding: 0 16px; }
      .links a { margin-left: 0; font-size: 13px; padding: 6px 6px; }
      .container { padding-top: 32px; }
      .container h1 { font-size: 2.125rem; }
      .paper { padding: 24px 16px; }
      .step-label { font-size: 12px; }
      .row { flex-direction: column; gap: 0; }
      .dash { flex-direction: column; }
      .drawer { width: 100%; flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid rgba(0,0,0,0.12); }
      .drawer .logo { width: 100%; }
      .drawer hr { display: none; }
      .kpis { grid-template-columns: 1fr; }
    }
  </style>
</body>
</html>
