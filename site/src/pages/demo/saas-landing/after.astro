  <script>
    import { split, usd, PAYMENTS } from "../../../components/demo/saas-landing/model";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function roll(el: HTMLElement, to: number, fmt: (n: number) => string) {
      const from = Number(el.dataset.v ?? to);
      el.dataset.v = String(to);
      if (from === to) return;
      if (reduce.matches) {
        el.classList.add("is-swapping");
        setTimeout(() => { el.textContent = fmt(to); el.classList.remove("is-swapping"); }, 150);
        return;
      }
      const start = performance.now();
      const dur = 260;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        el.textContent = fmt(Math.round(from + (to - from) * easeOut(t)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    const pay = document.querySelector<HTMLElement>("[data-pay]");
    if (pay) {
      const f = (k: string) => pay.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
      const bracket = pay.querySelector<HTMLElement>(".bracket")!;
      const live = pay.querySelector<HTMLElement>("[data-live]")!;
      const pc = (n: number, of: number) => `${((n / of) * 100).toFixed(2)}%`;
      const init = split(PAYMENTS[1].amount);
      (["tax", "se", "fed", "state", "keep", "q4Saved", "q4Estimate"] as const).forEach((k) => (f(k).dataset.v = String(init[k])));

      pay.querySelectorAll<HTMLInputElement>('input[name="payment"]').forEach((r) =>
        r.addEventListener("change", () => {
          const p = PAYMENTS[Number(r.value)];
          const s = split(p.amount);
          f("payer").textContent = p.payer;
          f("ref").textContent = p.ref;
          f("payment").textContent = `+${usd(p.amount)}`;
          f("pct").textContent = `${s.pct}%`;
          f("fedRate").textContent = s.crosses ? "12–22%" : "12%";
          (["tax", "se", "fed", "state", "keep", "q4Saved", "q4Estimate"] as const).forEach((k) => roll(f(k), s[k], usd));
          pay.style.setProperty("--a", pc(s.se, s.payment));
          pay.style.setProperty("--b", pc(s.se + s.fed, s.payment));
          pay.style.setProperty("--c", pc(s.tax, s.payment));
          pay.style.setProperty("--p1", pc(s.q4SavedBefore, s.q4Estimate));
          pay.style.setProperty("--p2", pc(s.q4Saved, s.q4Estimate));
          bracket.dataset.cross = String(s.crosses);
          bracket.querySelector('[data-when="cross"]')!.toggleAttribute("aria-hidden", !s.crosses);
          bracket.querySelector('[data-when="low"]')!.toggleAttribute("aria-hidden", s.crosses);
          live.textContent = `For a ${usd(p.amount)} payment from ${p.payer}, move ${usd(s.tax)} to tax savings. ${usd(s.keep)} is yours to spend.`;
        })
      );
    }

    const chart = document.querySelector<SVGElement>("[data-chart]");
    if (chart) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { chart.classList.add("is-in"); io.disconnect(); } });
      }, { rootMargin: "0px 0px -80px 0px" });
      io.observe(chart);
    }

    const review = document.querySelector<HTMLElement>("[data-review]");
    if (review) {
      const picked = review.querySelector<HTMLElement>("[data-picked]")!;
      const undo = review.querySelector<HTMLButtonElement>("[data-undo]")!;
      review.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) =>
        b.addEventListener("click", () => {
          picked.textContent = b.dataset.pick!;
          review.classList.add("is-done");
          undo.focus({ preventScroll: true });
        })
      );
      undo.addEventListener("click", () => {
        review.classList.remove("is-done");
        review.querySelector<HTMLButtonElement>("[data-pick]")!.focus({ preventScroll: true });
      });
    }

    const form = document.querySelector<HTMLFormElement>("[data-signup]");
    if (form) {
      form.noValidate = true;
      const input = form.querySelector<HTMLInputElement>("input")!;
      const hint = form.querySelector<HTMLElement>(".hint")!;
      const button = form.querySelector<HTMLButtonElement>("button")!;
      const defaultHint = hint.textContent;
      const setHint = (text: string | null, kind = "") => { hint.textContent = text; hint.className = `hint ${kind}`; };
      input.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid") === "true" && input.validity.valid) {
          input.removeAttribute("aria-invalid");
          setHint(defaultHint);
        }
      });
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        input.value = input.value.trim();
        if (!input.value || !input.validity.valid) {
          input.setAttribute("aria-invalid", "true");
          setHint(input.value ? "That email is missing something. Try the format name@studio.com." : "Enter your email so we can send your sign-in link.", "err");
          input.focus();
          return;
        }
        button.disabled = true;
        button.textContent = "Sending link…";
        setTimeout(() => {
          button.disabled = false;
          button.textContent = "Start 30-day trial";
          setHint(`Check ${input.value} for your sign-in link. It expires in 30 minutes.`, "ok");
        }, 700);
      });
    }
  </script>
