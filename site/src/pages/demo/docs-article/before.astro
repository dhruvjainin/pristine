<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Building an accessible dialog | Grain UI</title>
  <style is:global>
    :root {
      --primary: #2e8555; --primary-dark: #29784c; --primary-darkest: #205d3b;
      --content: #1c1e21; --secondary: #606770; --border: #dadde1; --emphasis-100: #f5f6f7; --emphasis-200: #ebedf0;
      --font: system-ui, -apple-system, "Segoe UI", Roboto, Ubuntu, Cantarell, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
      --mono: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
    * { box-sizing: border-box; }
    html { -webkit-font-smoothing: antialiased; }
    body { margin: 0; font-family: var(--font); font-size: 16px; line-height: 1.65; color: var(--content); background: #fff; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s cubic-bezier(0.08, 0.52, 0.52, 1); }
    a:hover { color: var(--primary-darkest); text-decoration: underline; }
    button { font: inherit; }

    .navbar { position: sticky; top: 0; z-index: 10; height: 60px; display: flex; align-items: center; padding: 0.5rem 1rem; background: #fff; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.1); }
    .navbar a { color: var(--content); }
    .navbar a:hover { color: var(--primary); text-decoration: none; }
    .brand { display: flex; align-items: center; gap: 0.5rem; margin-right: 1rem; font-weight: 700; }
    .brand svg { width: 32px; height: 32px; }
    .navbar-items { display: flex; align-items: center; }
    .navbar-items a { padding: 0.25rem 0.75rem; font-weight: 500; font-size: 15px; }
    .navbar-items a.active { color: var(--primary); }
    .navbar-right { margin-left: auto; display: flex; align-items: center; gap: 0.25rem; }
    .search-btn { display: flex; align-items: center; gap: 0.5rem; height: 36px; padding: 0 8px 0 10px; margin-left: 0.5rem; border: 0; border-radius: 40px; background: var(--emphasis-200); color: #969faf; font-size: 14px; cursor: pointer; }
    .search-btn kbd { font-family: var(--font); font-size: 11px; background: #f3f4f6; border-radius: 3px; box-shadow: inset 0 -2px 0 0 #cdcde6, inset 0 0 1px 1px #fff, 0 1px 2px 1px rgba(30,35,90,0.4); color: #969faf; padding: 0 4px; }
    .toggle-menu { display: none; background: none; border: 0; padding: 0; margin-right: 0.5rem; color: var(--content); cursor: pointer; }

    .layout { display: flex; }
    .sidebar { width: 300px; flex-shrink: 0; border-right: 1px solid var(--border); }
    .sidebar nav { position: sticky; top: 60px; max-height: calc(100vh - 60px); overflow-y: auto; padding: 0.5rem; font-size: 15px; font-weight: 500; }
    .menu-list { list-style: none; margin: 0; padding: 0; }
    .menu-list .menu-list { padding-left: 1rem; margin-top: 0.25rem; }
    .menu-item { margin-top: 0.25rem; }
    .menu-link, .menu-cat { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0.375rem 1rem; border-radius: 0.25rem; color: var(--secondary); line-height: 1.25; text-align: left; background: none; border: 0; cursor: pointer; font-weight: 500; font-size: 15px; }
    .menu-cat { color: var(--content); }
    .menu-link:hover, .menu-cat:hover { background: rgba(0,0,0,0.05); color: var(--secondary); text-decoration: none; }
    .menu-link.active { color: var(--primary); background: rgba(0,0,0,0.05); }
    .menu-cat::after { content: ""; width: 1.25rem; height: 1.25rem; background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="rgba(0,0,0,0.5)" d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path></svg>') 50% / 2rem 2rem; transform: rotate(180deg); transition: transform 0.2s linear; }
    .menu-item.collapsed > .menu-cat::after { transform: rotate(90deg); }
    .menu-item.collapsed > .menu-list { display: none; }

    .main { flex: 1; min-width: 0; padding: 2rem 1rem; }
    .row { display: flex; max-width: 1320px; margin: 0 auto; }
    .doc { flex: 0 0 75%; max-width: 75%; padding: 0 1rem; }
    .toc-col { flex: 0 0 25%; max-width: 25%; padding: 0 1rem; }

    .breadcrumbs { display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 0.8rem; font-size: 0.8rem; font-weight: 500; }
    .breadcrumbs li { display: flex; align-items: center; gap: 0.5rem; }
    .breadcrumbs li + li::before { content: "›"; color: var(--secondary); opacity: 0.6; font-size: 1rem; }
    .breadcrumbs a, .breadcrumbs span { padding: 0.2rem 0.8rem; border-radius: 1.5rem; color: var(--content); }
    .breadcrumbs a:hover { background: rgba(0,0,0,0.05); text-decoration: none; }
    .breadcrumbs .home { padding: 0.2rem 0.4rem; display: flex; }
    .breadcrumbs .current { background: rgba(0,0,0,0.05); color: var(--primary); }

    .markdown { --space: 1.25rem; }
    .markdown h1, .markdown h2, .markdown h3 { font-weight: 700; line-height: 1.25; margin: 0 0 var(--space); }
    .markdown h1 { font-size: 3rem; }
    .markdown h2 { font-size: 2rem; margin-top: calc(var(--space) * 2.5); }
    .markdown h3 { font-size: 1.5rem; margin-top: calc(var(--space) * 1.5); }
    .hash-link { opacity: 0; padding-left: 0.5rem; }
    .hash-link::before { content: "#"; }
    h2:hover .hash-link { opacity: 1; }
    .markdown p { margin: 0 0 var(--space); }
    code { font-family: var(--mono); font-size: 90%; background: rgba(0,0,0,0.04); border: 0.1rem solid rgba(0,0,0,0.1); border-radius: 0.4rem; padding: 0.1rem; vertical-align: middle; }

    .codeblock { position: relative; margin-bottom: var(--space); border-radius: 0.4rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.1); background: #f6f8fa; }
    pre { margin: 0; padding: 1rem; overflow: auto; font-size: 90%; line-height: 1.45; color: #393a34; background: #f6f8fa; border-radius: 0.4rem; }
    pre code { border: 0; background: none; padding: 0; font-size: 100%; vertical-align: baseline; }
    .k { color: #00009f; } .s { color: #a31515; } .c { color: #999988; font-style: italic; } .f { color: #d73a49; } .t { color: #00009f; } .a { color: #00a4db; }
    .copybtn { position: absolute; top: 0.5rem; right: 0.5rem; display: flex; padding: 0.4rem; border: 1px solid var(--border); border-radius: 0.4rem; background: #f6f8fa; color: #393a34; opacity: 0; cursor: pointer; transition: opacity 0.2s ease-in-out; }
    .codeblock:hover .copybtn, .copybtn:focus-visible { opacity: 0.4; }
    .copybtn:hover { opacity: 1 !important; }

    .admonition { margin-bottom: 1em; padding: 1rem; border: 1px solid; border-left-width: 5px; border-radius: 0.4rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.1); }
    .admonition-heading { display: flex; align-items: center; gap: 0.4em; margin-bottom: 0.3rem; font: 700 14px/1.25 var(--font); text-transform: uppercase; }
    .admonition-heading svg { fill: currentColor; }
    .admonition-content p:last-child { margin: 0; }
    .admonition-content code { background: rgba(0,0,0,0.05); }
    .admonition-note { background: #fdfdfe; border-color: #d4d5d8; color: #474748; }
    .admonition-tip { background: #e6f6e6; border-color: #009400; color: #003100; }
    .admonition-info { background: #eef9fd; border-color: #4cb3d4; color: #193c47; }
    .admonition-warning { background: #fff8e6; border-color: #e6a700; color: #4d3800; }
    .admonition-danger { background: #ffebec; border-color: #e13238; color: #4b1113; }

    table { display: block; overflow: auto; border-collapse: collapse; margin-bottom: var(--space); }
    th, td { border: 1px solid var(--border); padding: 0.75rem; text-align: left; }
    th { font-weight: 700; }
    tbody tr:nth-child(2n) { background: rgba(0,0,0,0.03); }

    .doc-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; }
    .doc-footer a { display: inline-flex; align-items: center; gap: 0.3rem; }
    .last-updated { font-size: smaller; font-style: italic; color: var(--secondary); }
    .pagination-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
    .pagination-link { display: block; padding: 1rem; border: 1px solid var(--border); border-radius: 0.4rem; line-height: 1.25; transition: border-color 0.2s cubic-bezier(0.08, 0.52, 0.52, 1); }
    .pagination-link:hover { border-color: var(--primary); text-decoration: none; }
    .pagination-link.next { grid-column: 2; text-align: right; }
    .sublabel { display: block; margin-bottom: 0.25rem; font-size: 0.875rem; font-weight: 500; color: var(--secondary); }
    .label { display: block; font-weight: 700; word-break: break-word; }

    .toc { position: sticky; top: calc(60px + 1rem); max-height: calc(100vh - 76px); overflow-y: auto; border-left: 1px solid var(--border); }
    .toc ul { list-style: none; margin: 0; padding: 0 0 0 0.5rem; font-size: 0.8rem; }
    .toc li { margin: 0.5rem 0.5rem; }
    .toc a { color: var(--content); }
    .toc a:hover, .toc a.active { color: var(--primary); text-decoration: none; }
    .toc-mobile { display: none; }

    .footer { padding: 2rem 1rem; background: #303846; color: #ebedf0; text-align: center; font-size: 15px; }

    @media (max-width: 996px) {
      .sidebar, .toc-col, .navbar-items, .search-btn .label-text, .search-btn kbd { display: none; }
      .toggle-menu { display: flex; }
      .doc { flex-basis: 100%; max-width: 100%; padding: 0; }
      .main { padding: 1rem; }
      .markdown h1 { font-size: 2rem; }
      .toc-mobile { display: block; margin: 0 0 1rem; background: var(--emphasis-100); border-radius: 0.4rem; font-size: 15px; }
      .toc-mobile summary { padding: 0.4rem 0.8rem; font-weight: 500; cursor: pointer; }
      .toc-mobile ul { list-style: none; margin: 0; padding: 0 0.8rem 0.8rem 1rem; border-top: 1px solid var(--border); }
      .toc-mobile li { margin-top: 0.5rem; }
      .toc-mobile a { color: var(--content); }
      .search-btn { padding: 0 10px; }
      .layout.menu-open .sidebar { display: block; position: fixed; top: 60px; left: 0; bottom: 0; z-index: 20; width: 83vw; background: #fff; box-shadow: 0 0 20px rgba(0,0,0,0.3); overflow-y: auto; }
    }
