---
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/jetbrains-mono";
import "../../../components/demo/docs-article/theme.css";

const basic = `<span class="tk">import</span> { Dialog, Button } <span class="tk">from</span> <span class="ts">"@grain-ui/react"</span>;

<span class="tk">export function</span> <span class="tf">DeleteProject</span>({ project, onDelete }) {
  <span class="tk">return</span> (
    &lt;<span class="tt">Dialog.Root</span>&gt;
      &lt;<span class="tt">Dialog.Trigger</span> <span class="ta">asChild</span>&gt;
        &lt;<span class="tt">Button</span> <span class="ta">variant</span>=<span class="ts">"danger"</span>&gt;Delete {project.name}…&lt;/<span class="tt">Button</span>&gt;
      &lt;/<span class="tt">Dialog.Trigger</span>&gt;
<span class="hl">      &lt;<span class="tt">Dialog.Content</span> <span class="ta">closeOnBackdrop</span>={<span class="tk">false</span>}&gt;</span>
        &lt;<span class="tt">Dialog.Title</span>&gt;Delete {project.name}?&lt;/<span class="tt">Dialog.Title</span>&gt;
        &lt;<span class="tt">Dialog.Description</span>&gt;
          This removes {project.deployments} deployments. It can’t be undone.
        &lt;/<span class="tt">Dialog.Description</span>&gt;
        &lt;<span class="tt">Dialog.Close</span> <span class="ta">asChild</span>&gt;
          &lt;<span class="tt">Button</span>&gt;Cancel&lt;/<span class="tt">Button</span>&gt;
        &lt;/<span class="tt">Dialog.Close</span>&gt;
<span class="hl">        &lt;<span class="tt">Button</span> <span class="ta">variant</span>=<span class="ts">"danger"</span> <span class="ta">onClick</span>={onDelete}&gt;Delete project&lt;/<span class="tt">Button</span>&gt;</span>
      &lt;/<span class="tt">Dialog.Content</span>&gt;
    &lt;/<span class="tt">Dialog.Root</span>&gt;
  );
}`;

const focus = `<span class="tk">const</span> cancelRef = <span class="tf">useRef</span>(<span class="tk">null</span>);

<span class="hl">&lt;<span class="tt">Dialog.Content</span> <span class="ta">initialFocus</span>={cancelRef}&gt;</span>
  <span class="tc">{/* Destructive dialogs start on the safe action */}</span>
  &lt;<span class="tt">Dialog.Close</span> <span class="ta">asChild</span>&gt;
<span class="hl">    &lt;<span class="tt">Button</span> <span class="ta">ref</span>={cancelRef}&gt;Cancel&lt;/<span class="tt">Button</span>&gt;</span>
  &lt;/<span class="tt">Dialog.Close</span>&gt;
&lt;/<span class="tt">Dialog.Content</span>&gt;`;

const css = `<span class="tc">/* What Dialog.Content ships with: enter in 220ms, centered */</span>
<span class="tt">dialog</span> {
  <span class="ta">opacity</span>: <span class="ts">0</span>;
  <span class="ta">transform</span>: <span class="tf">scale</span>(<span class="ts">0.96</span>);
  <span class="ta">transition</span>: opacity <span class="ts">220ms</span> var(--grain-ease-out),
              transform <span class="ts">220ms</span> var(--grain-ease-out);
}
<span class="tt">dialog[open]</span> { <span class="ta">opacity</span>: <span class="ts">1</span>; <span class="ta">transform</span>: none; }
<span class="tk">@starting-style</span> {
  <span class="tt">dialog[open]</span> { <span class="ta">opacity</span>: <span class="ts">0</span>; <span class="ta">transform</span>: <span class="tf">scale</span>(<span class="ts">0.96</span>); }
}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="color-scheme" content="light dark" />
  <title>Building an accessible dialog · Grain UI docs</title>
  <dialog class="dlg" id="demo-dlg" aria-labelledby="demo-title" aria-describedby="demo-desc">
    <form method="dialog">
      <h2 id="demo-title">Delete atlas-web?</h2>
      <p id="demo-desc">This removes 14 deployments. It can’t be undone.</p>
      <div class="foot">
        <button class="btn" value="cancel" autofocus data-n="cancel">Cancel</button>
        <button class="btn btn-danger" value="delete" data-n="confirm">Delete project</button>
      </div>
    </form>
  </dialog>

  <script is:inline>document.documentElement.classList.add("js");</script>
  <style is:global>
    :root {
      color-scheme: light dark;
      --font-sans: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
      --font-mono: "JetBrains Mono Variable", ui-monospace, "SF Mono", Menlo, monospace;


      --r-sm: 6px; --r-md: 8px; --r-lg: 12px;
      --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 24px; --s-6: 32px; --s-7: 48px; --s-8: 64px;
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --dur-press: 140ms; --dur-small: 180ms;
      --topbar: 60px;
      --measure: 70ch;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--topbar) + 24px); scrollbar-color: var(--border-strong) var(--bg); }
    @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
    body {
      margin: 0; background: var(--bg); color: var(--text-2);
      font: 400 1rem/1.6 var(--font-sans); font-optical-sizing: auto; font-feature-settings: "cv11", "ss01";
      -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent;
      caret-color: var(--accent); accent-color: var(--accent);
    }
    ::selection { background: var(--accent-soft); color: var(--text); }
    a { color: var(--accent-text); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
    @media (hover: hover) and (pointer: fine) { a:hover { text-decoration-thickness: 2px; } }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
    .icon { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .skip { position: absolute; left: var(--s-4); top: -60px; z-index: 50; background: var(--surface); color: var(--text); padding: var(--s-2) var(--s-4); border-radius: var(--r-md); }
    .skip:focus-visible { top: var(--s-2); }

    /* ---------- top bar ---------- */
    .topbar { position: sticky; top: 0; z-index: 10; height: var(--topbar); background: var(--bg); border-bottom: 1px solid var(--border); }
    .topbar-inner { max-width: 1440px; height: 100%; margin: 0 auto; padding: 0 var(--s-5); display: flex; align-items: center; gap: var(--s-5); }
    .brand { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--text); font-weight: 650; letter-spacing: -0.01em; text-decoration: none; flex-shrink: 0; }
    .brand svg { width: 24px; height: 24px; }
    .brand small { font-weight: 500; color: var(--text-3); font-size: 0.9375rem; }
    .search { position: relative; flex: 1; max-width: 400px; margin-left: var(--s-4); }
    .search .icon { position: absolute; left: 12px; top: 50%; translate: 0 -50%; color: var(--text-3); pointer-events: none; }
    .search input { width: 100%; height: 40px; padding: 0 56px 0 36px; border-radius: var(--r-md); border: 1px solid var(--border); background: var(--surface-2); color: var(--text); font: 400 1rem/1 var(--font-sans); transition: border-color 150ms ease, background-color 150ms ease; }
    .search input::placeholder { color: var(--text-3); }
    .search input:focus-visible { outline-offset: 1px; border-color: var(--focus); background: var(--surface); border-radius: var(--r-md); }
    .search kbd { position: absolute; right: 8px; top: 50%; translate: 0 -50%; font: 500 0.75rem/1 var(--font-sans); color: var(--text-3); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 4px 6px; background: var(--surface); }
    .topnav { display: flex; gap: var(--s-1); margin-left: auto; }
    .topnav a { color: var(--text-2); text-decoration: none; font-size: 0.9375rem; font-weight: 500; padding: 10px var(--s-3); border-radius: var(--r-md); transition: background-color 150ms ease; }
    .topnav a[aria-current] { color: var(--text); }
    @media (hover: hover) and (pointer: fine) { .topnav a:hover { background: var(--hover); color: var(--text); } }

    /* ---------- three-column layout ---------- */
    .layout { max-width: 1360px; margin: 0 auto; padding: 0 var(--s-5); display: grid; grid-template-columns: 232px minmax(0, 1fr) 216px; gap: var(--s-7); }
    .rail { position: sticky; top: var(--topbar); align-self: start; max-height: calc(100dvh - var(--topbar)); overflow: auto; padding: var(--s-6) 0 var(--s-7); overscroll-behavior: contain; }
    .docnav h2, .toc h2 { font-size: 0.8125rem; font-weight: 600; color: var(--text); margin: 0 0 var(--s-2); padding-left: var(--s-3); }
    .docnav section + section { margin-top: var(--s-5); }
    .docnav ul, .toc ul { list-style: none; margin: 0; padding: 0; }
    .docnav a { display: block; padding: 6px var(--s-3); border-radius: var(--r-md); color: var(--text-2); text-decoration: none; font-size: 0.9375rem; line-height: 1.4; transition: background-color 150ms ease; }
    .docnav a[aria-current="page"] { background: var(--accent-soft); color: var(--accent-text); font-weight: 550; }
    @media (hover: hover) and (pointer: fine) { .docnav a:not([aria-current]):hover { background: var(--hover); color: var(--text); } }
    .toc ul { border-left: 1px solid var(--border); }
    .toc li a { display: block; margin-left: -1px; padding: 5px var(--s-3); border-left: 2px solid transparent; color: var(--text-3); text-decoration: none; font-size: 0.875rem; line-height: 1.4; transition: color 150ms ease, border-color 150ms ease; }
    .toc .sub a { padding-left: var(--s-5); }
    .toc li a[aria-current="true"] { color: var(--accent-text); border-left-color: var(--accent); font-weight: 550; }
    @media (hover: hover) and (pointer: fine) { .toc li a:hover { color: var(--text); } }
    .toc-foot { margin-top: var(--s-5); padding-top: var(--s-4); border-top: 1px solid var(--border); display: grid; gap: var(--s-2); font-size: 0.875rem; }
    .toc-foot a { display: inline-flex; gap: 6px; align-items: center; color: var(--text-3); text-decoration: none; padding: 4px 0; }
    @media (hover: hover) and (pointer: fine) { .toc-foot a:hover { color: var(--text); } }

    /* mobile disclosures */
    .mobile-nav, .mobile-toc { display: none; }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    .disclosure { border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
    .disclosure summary { display: flex; align-items: center; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-4); font-size: 0.9375rem; font-weight: 550; color: var(--text); border-radius: var(--r-lg); }
    .disclosure summary .chev { margin-left: auto; color: var(--text-3); transition: transform var(--dur-small) var(--ease-out); }
    .disclosure[open] summary .chev { transform: rotate(180deg); }
    .disclosure .panel { padding: 0 var(--s-2) var(--s-3); }
    .disclosure .panel .toc ul { margin-left: var(--s-3); }

    /* ---------- article ---------- */
    main { min-width: 0; padding: var(--s-6) 0 var(--s-8); }
    article { max-width: var(--measure); margin-inline: auto; }
    .crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 0.875rem; color: var(--text-3); margin: 0 0 var(--s-3); padding: 0; list-style: none; }
    .crumbs a { color: var(--text-3); text-decoration: none; }
    .crumbs li + li::before { content: "/"; margin-right: 6px; color: var(--border-strong); }
    @media (hover: hover) and (pointer: fine) { .crumbs a:hover { color: var(--text); text-decoration: underline; } }
    h1, h2, h3 { color: var(--text); text-wrap: balance; }
    h1 { font-size: clamp(2.25rem, 1.7rem + 1.6vw, 3rem); line-height: 1.06; font-weight: 680; letter-spacing: -0.032em; margin: 0 0 var(--s-4); }
    .lede { font-size: 1.1875rem; line-height: 1.6; color: var(--text-2); margin: 0 0 var(--s-4); }
    .lede code { font-family: var(--font-mono); font-size: 0.875em; color: var(--text); background: var(--inline-code-bg); padding: 0.1em 0.34em; border-radius: 5px; }
    .byline { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); font-size: 0.875rem; color: var(--text-3); padding-bottom: var(--s-6); border-bottom: 1px solid var(--border); margin-bottom: var(--s-2); }
    .prose { font-size: 1.0625rem; line-height: 1.7; }
    .prose p, .prose ul, .prose ol { margin: 0 0 1.15em; text-wrap: pretty; }
    .prose ul, .prose ol { padding-left: 1.25em; }
    .prose li { margin-bottom: 0.4em; padding-left: 0.2em; }
    .prose li::marker { color: var(--text-3); }
    .prose strong { color: var(--text); font-weight: 600; }
    .prose h2 { font-size: 1.625rem; line-height: 1.2; font-weight: 650; letter-spacing: -0.018em; margin: 2.2em 0 0.6em; }
    .prose h3 { font-size: 1.25rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; margin: 1.8em 0 0.5em; }
    .prose h2 + h3 { margin-top: 1em; }
    .anchor { position: relative; }
    .anchor a.hash { position: absolute; left: -1.1em; top: 0; padding-right: 0.3em; color: var(--text-3); text-decoration: none; opacity: 0; transition: opacity 150ms ease; font-weight: 500; }
    .anchor:hover a.hash, .anchor a.hash:focus-visible { opacity: 1; }
    @media (hover: none) { .anchor a.hash { display: none; } }
    .prose :not(pre) > code { font-family: var(--font-mono); font-size: 0.875em; background: var(--inline-code-bg); color: var(--text); padding: 0.12em 0.36em; border-radius: 5px; overflow-wrap: anywhere; }
    kbd { font: 500 0.8125em/1 var(--font-sans); color: var(--text); padding: 3px 6px; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: var(--r-sm); background: var(--surface); }

    /* code blocks */
    .code { margin: 1.5em 0; border: 1px solid var(--code-border); border-radius: var(--r-lg); background: var(--code-bg); overflow: hidden; }
    .code-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); height: 44px; padding: 0 var(--s-2) 0 var(--s-4); border-bottom: 1px solid var(--code-border); font-size: 0.8125rem; color: var(--text-3); }
    .code-head span { font-family: var(--font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .copy { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border: 0; border-radius: var(--r-md); background: transparent; color: var(--text-2); font: 500 0.8125rem/1 var(--font-sans); cursor: pointer; transition: background-color 150ms ease, transform var(--dur-press) var(--ease-out); position: relative; }
    .copy::after { content: ""; position: absolute; inset: -6px; }
    @media (hover: hover) and (pointer: fine) { .copy:hover { background: var(--hover); color: var(--text); } }
    .copy:active { transform: scale(0.97); }
    .copy .done { display: none; }
    .copy[data-copied] .done { display: inline; }
    .copy[data-copied] .idle { display: none; }
    pre { margin: 0; padding: var(--s-4) var(--s-5); overflow-x: auto; tab-size: 2; }
    pre code { font: 400 0.875rem/1.7 var(--font-mono); color: var(--code-text); font-variant-ligatures: none; }
    .tk { color: var(--tk); } .ts { color: var(--ts); } .tc { color: var(--tc); font-style: italic; } .tf { color: var(--tf); } .tt { color: var(--tt); } .ta { color: var(--ta); }

    /* callouts */
    .callout { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--s-3); margin: 1.5em 0; padding: var(--s-4) var(--s-5) var(--s-4) var(--s-4); border-radius: var(--r-lg); background: var(--surface-2); font-size: 1rem; line-height: 1.6; }
    .callout .icon { width: 20px; height: 20px; margin-top: 2px; color: var(--text-3); }
    .callout p { margin: 0; }
    .callout p + p { margin-top: 0.5em; }
    .callout strong { display: block; margin-bottom: 2px; }
    .callout.warning { background: var(--warning-bg); color: var(--warning); }
    .callout.warning strong { color: var(--warning); }
    .callout.warning .icon { color: var(--warning-icon); }

    /* props table */
    .table-wrap { margin: 1.5em 0; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
    table { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 0.9375rem; line-height: 1.5; }
    caption { text-align: left; padding: var(--s-3) var(--s-4); font-size: 0.875rem; color: var(--text-3); border-bottom: 1px solid var(--border); }
    th { text-align: left; font-size: 0.8125rem; font-weight: 600; color: var(--text-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: 0; }
    td code { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text); }
    td:first-child code { font-weight: 600; white-space: nowrap; }
    td.type code { color: var(--tf); white-space: nowrap; }
    td.def { white-space: nowrap; color: var(--text-3); }
    td.desc { min-width: 220px; }

    /* prev / next */
    .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-top: var(--s-7); padding-top: var(--s-6); border-top: 1px solid var(--border); }
    .pager a { display: grid; gap: 2px; padding: var(--s-4) var(--s-5); border: 1px solid var(--border); border-radius: var(--r-lg); text-decoration: none; background: var(--surface); transition: border-color 150ms ease, transform var(--dur-press) var(--ease-out); min-width: 0; }
    .pager a:active { transform: scale(0.98); }
    .pager small { font-size: 0.8125rem; color: var(--text-3); display: inline-flex; gap: 6px; align-items: center; }
    .pager span { font-size: 1.0625rem; font-weight: 600; color: var(--text); }
    .pager .next { text-align: right; justify-items: end; }
    @media (hover: hover) and (pointer: fine) { .pager a:hover { border-color: var(--accent); } }
    .feedback { margin-top: var(--s-6); font-size: 0.875rem; color: var(--text-3); display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); justify-content: space-between; }


    /* reading progress: pure CSS where scroll timelines exist */
    .progress { position: fixed; top: calc(var(--topbar) - 1px); left: 0; right: 0; height: 2px; z-index: 11; pointer-events: none; display: none; }
    @supports (animation-timeline: scroll()) {
      .progress { display: block; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); animation: read linear both; animation-timeline: scroll(root); }
      @keyframes read { to { transform: scaleX(1); } }
    }

    /* highlighted lines */
    pre { --px: var(--s-5); }
    .hl { display: inline-block; min-width: calc(100% + 2 * var(--px)); margin: 0 calc(-1 * var(--px)); padding: 0 var(--px); background: var(--hl); }

    /* buttons used by the live example */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2); height: 40px; padding: 0 var(--s-4); border-radius: var(--r-md); border: 1px solid var(--border); background: var(--surface); color: var(--text); font: 550 0.9375rem/1 var(--font-sans); cursor: pointer; white-space: nowrap; box-shadow: var(--shadow-sm); position: relative; transition: transform var(--dur-press) var(--ease-out), background-color 150ms ease, border-color 150ms ease; }
    .btn::after { content: ""; position: absolute; inset: -3px 0; }
    .btn:active { transform: scale(0.97); }
    .btn-danger { background: var(--danger); border-color: transparent; color: var(--on-danger); }
    .btn-danger-quiet { color: var(--danger-text); }
    .btn-sm { height: 36px; padding: 0 var(--s-3); font-size: 0.875rem; }
    @media (hover: hover) and (pointer: fine) {
      .btn:hover { background: var(--hover); }
      .btn-danger:hover { background: var(--danger-hover); }
    }

    /* ---------- live example (signature) ---------- */
    .demo { margin: 1.75em 0 2em; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); overflow: hidden; }
    .demo-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border); font-size: 0.875rem; color: var(--text-3); }
    .demo-tag { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--text); }
    .demo-tag::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--ok); }
    .demo-stage { padding: var(--s-6) var(--s-5); background: var(--surface-2); background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 16px 16px; background-position: -8px -8px; }
    .proj { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-4); max-width: 520px; margin: 0 auto; padding: var(--s-4); border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-sm); }
    .proj-main { flex: 1 1 200px; min-width: 0; display: grid; gap: 2px; }
    .proj b { color: var(--text); font-weight: 620; font-size: 0.9375rem; }
    .proj span { font-size: 0.875rem; color: var(--text-3); }
    .proj[data-gone] .proj-main b { text-decoration: line-through; color: var(--text-3); }
    .prose .trace { list-style: none; margin: 0; padding: var(--s-4) var(--s-4) var(--s-3); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-2); counter-reset: t; border-top: 1px solid var(--border); }
    .prose .trace li { margin: 0; position: relative; display: grid; gap: 2px; padding: var(--s-2) var(--s-3); border-radius: var(--r-md); border: 1px solid var(--border); font-size: 0.875rem; line-height: 1.35; color: var(--text-2); counter-increment: t; transition: border-color 180ms var(--ease-out), background-color 180ms var(--ease-out), color 180ms var(--ease-out); }
    .trace li b { font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 6px; }
    .trace li b::before { content: counter(t); display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; font-size: 0.6875rem; font-weight: 650; background: var(--surface-2); color: var(--text-3); flex-shrink: 0; transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out); }
