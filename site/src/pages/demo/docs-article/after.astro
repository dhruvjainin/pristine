          <li><a href="#motion">Motion</a></li>
          <li><a href="#props">Props</a></li>
          <li><a href="#checklist">Accessibility checklist</a></li>
        </ul>
        <div class="toc-foot">
          <a href="#top"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg>Edit this page</a>
          <a href="#top"><svg class="icon" aria-hidden="true"><use href="#i-left" style="transform:rotate(90deg);transform-origin:center"/></svg>Back to top</a>
        </div>
      </nav>
    </aside>
  </div>

  <script is:inline>
    (() => {
      document.querySelectorAll('.copy').forEach((b) => b.addEventListener('click', async () => {
        const text = b.closest('figure').querySelector('pre').innerText;
        try { await navigator.clipboard.writeText(text); } catch { return; }
        const label = b.getAttribute('aria-label');
        b.dataset.copied = ''; b.setAttribute('aria-label', 'Copied');
        setTimeout(() => { delete b.dataset.copied; b.setAttribute('aria-label', label); }, 1600);
      }));


      /* live example: the real dialog, with its focus path traced */
      const dlg = document.getElementById('demo-dlg');
      const trigger = document.getElementById('demo-trigger');
      const proj = document.getElementById('proj');
      const log = document.getElementById('log');
      const nodes = Object.fromEntries([...document.querySelectorAll('.trace li')].map((li) => [li.dataset.n, li]));
      const mark = (now) => {
        const order = ['trigger', 'cancel', 'confirm', 'return'];
        const i = order.indexOf(now);
        order.forEach((n, j) => { nodes[n].dataset.s = j < i ? 'done' : j === i ? 'now' : ''; });
      };
      const say = (t) => { log.textContent = t; log.classList.remove('swap'); void log.offsetWidth; log.classList.add('swap'); };
      let reason = 'cancel';
      if (!('command' in HTMLButtonElement.prototype)) trigger.addEventListener('click', () => dlg.showModal());
      trigger.addEventListener('focus', () => { if (!dlg.open) mark('trigger'); });
      dlg.addEventListener('focusin', (e) => { const n = e.target.dataset.n; if (n) mark(n); });
      dlg.addEventListener('cancel', () => { reason = 'escape'; });
      dlg.addEventListener('click', (e) => {
        if (e.target !== dlg) return;
        const r = dlg.getBoundingClientRect();
        if (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) return;
        dlg.classList.remove('nudge'); void dlg.offsetWidth; dlg.classList.add('nudge');
        say('backdrop click ignored · closeOnBackdrop={false}');
      });
      dlg.addEventListener('close', () => {
        const deleted = dlg.returnValue === 'delete';
        const why = deleted ? 'delete' : reason;
        reason = 'cancel'; dlg.returnValue = '';
        if (deleted) {
          proj.dataset.gone = '';
          document.getElementById('proj-meta').textContent = 'Deleted just now';
          trigger.textContent = 'Undo delete'; trigger.classList.remove('btn-danger-quiet');
          document.getElementById('ret-name').textContent = 'Undo delete';
          document.getElementById('ret-why').textContent = 'returnFocus={listRef}';
          say('onDelete() · onOpenChange(false)');
        } else say(`onOpenChange(false) · reason: "${why}"`);
        trigger.focus(); mark('return');
      });
      trigger.addEventListener('click', (e) => {
        if (!proj.hasAttribute('data-gone')) return;
        e.preventDefault(); e.stopImmediatePropagation();
        delete proj.dataset.gone;
        document.getElementById('proj-meta').textContent = 'Production · 14 deployments · 3 domains';
        trigger.textContent = 'Delete atlas-web…'; trigger.classList.add('btn-danger-quiet');
        document.getElementById('ret-name').textContent = 'Back to trigger';
        document.getElementById('ret-why').textContent = 'returnFocus';
        say('restored · 14 deployments');
        Object.values(nodes).forEach((n) => { n.dataset.s = ''; });
      }, true);

      const helpful = document.getElementById('helpful');
      helpful.addEventListener('click', (e) => {
        const v = e.target.closest('[data-vote]')?.dataset.vote;
        if (!v) return;
        helpful.querySelectorAll('[data-vote]').forEach((b) => b.remove());
        document.getElementById('helpful-a').textContent = v === 'yes' ? 'Thanks. Glad it helped.' : 'Thanks. Tell us what was missing on GitHub Discussions.';
      });

      const q = document.getElementById('q');
      addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); q.focus(); } });

      const links = [...document.querySelectorAll('.rail-right .toc li a')];
      const heads = links.map((l) => document.querySelector(l.hash));
      let ticking = false;
      const sync = () => {
        ticking = false;
        let i = 0;
        heads.forEach((h, j) => { if (h.getBoundingClientRect().top < 120) i = j; });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) i = heads.length - 1;
        links.forEach((l, j) => l.setAttribute('aria-current', j === i ? 'true' : 'false'));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
      sync();
    })();
  </script>
</body>
</html>
