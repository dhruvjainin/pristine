---
import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces/full.css";
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="noindex" />
<title>{title} · Ledgerline</title>
<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f8f7f3; --surface: #ffffff; --ink: #1a1f24; --ink-2: #434a52; --ink-3: #626a72;
    --line: #e4e1da; --accent: #1d5a85; --on-accent: #ffffff; --accent-soft: #e5eef4;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #101417; --surface: #171d21; --ink: #eef1f3; --ink-2: #b9c0c6; --ink-3: #98a1a9; --line: #2a3238; --accent: #86bde3; --on-accent: #0c1a24; --accent-soft: #17303f; }
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; padding: 24px; background: var(--bg); color: var(--ink); font: 400 15px/1.55 "Inter Variable", system-ui, sans-serif; }
  h1, h2, h3, p, ul, dl, dd { margin: 0; }
  h1 { font: 500 clamp(1.75rem, 5.5cqi + 0.5rem, 2.5rem)/1.08 "Fraunces Variable", Georgia, serif; letter-spacing: -0.02em; text-wrap: balance; }
  .eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .lede { color: var(--ink-2); max-width: 46ch; }
  .num { font-variant-numeric: tabular-nums; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 18px; border-radius: 6px; background: var(--accent); color: var(--on-accent); font-weight: 600; text-decoration: none; border: 1px solid var(--accent); }
  .btn--quiet { background: transparent; color: var(--ink); border-color: var(--line); }
  a:focus-visible, input:focus-visible + label, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) { .btn { transition: transform 120ms ease; } .btn:active { transform: scale(0.97); } }
</style>
</head>
<body><main><slot /></main></body>
</html>
