---
interface Props { cmd: string; label?: string; size?: "md" | "lg"; wrap?: boolean; }
const { cmd, label = "Copy command", size = "md", wrap = false } = Astro.props;
const SUBS = new Set(["init", "critique", "design", "polish"]);
const LENSES = new Set(["bolder", "quieter", "colorize", "decolorize", "typeset", "layout", "consistency", "adapt", "animate", "delight", "overdrive", "clarify", "distill", "harden", "optimize", "polish-details"]);
const copyText = cmd.replace(/\s*\[[^\]]+\]/g, "").trim();
let word = 0, isPristine = false, inLenses = false;
const tokens = (cmd.match(/\[[^\]]+\]|"[^"]*"|\s+|\S+/g) ?? []).map((t) => {
  if (/^\s+$/.test(t)) return { t, k: "" };
  if (t.startsWith("[")) return { t, k: "attach" };
  if (t === "&&") { word = 0; return { t, k: "op" }; }
  const i = word++;
  if (i === 0) { isPristine = t === "/pristine"; return { t, k: "bin" }; }
  if (i === 1 && isPristine && SUBS.has(t)) { inLenses = t === "polish"; return { t, k: "sub" }; }
  if (inLenses && LENSES.has(t)) return { t, k: "lens" };
  inLenses = false;
  if (t.startsWith('"')) return { t, k: "str" };
  if (t.startsWith("-")) return { t, k: "flag" };
  return { t, k: "arg" };
});
---
<div class:list={["copy", `copy--${size}`, { "copy--wrap": wrap }]} data-copy>
  <code><span class="copy__prompt" aria-hidden="true">$</span>{tokens.map(({ t, k }) => k ? <span class={`tk tk--${k}`}>{t}</span> : t)}</code>
  <button type="button" data-copy-btn data-cmd={copyText} aria-label={label}>
    <svg class="copy__icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <svg class="copy__check" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="copy__status" role="status"></span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-btn]").forEach((b) => {
    if (b.dataset.bound) return; b.dataset.bound = "1";
    b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.cmd!); } catch { return; }
      const s = b.querySelector(".copy__status")!;
      b.classList.add("is-copied"); s.textContent = "Copied";
      setTimeout(() => { b.classList.remove("is-copied"); s.textContent = ""; }, 1600);
    });
  });
</script>
<style>
  .copy { display: flex; align-items: center; gap: var(--s-2); min-width: 0; max-width: 100%; min-height: var(--control-h); box-sizing: border-box; padding: 3px 3px 3px var(--s-4); border: 1px solid var(--rule); border-radius: var(--radius-sm); background: var(--surface); }
  .copy code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: var(--text-sm); scrollbar-width: none; }
  .copy--lg code { font-size: var(--text-md); }
  .copy--wrap { align-items: flex-start; }
  .copy--wrap code { white-space: normal; overflow-wrap: anywhere; padding-block: 10px; line-height: 1.55; }
  @media (max-width: 480px) { .copy code, .copy--lg code { font-size: 0.8125rem; } .copy { padding-left: var(--s-3); } }
  .tk--bin { color: var(--ink); font-weight: 650; }
  .tk--sub { color: var(--on-mark); background: var(--mark); font-weight: 650; padding: 1px 4px; margin-inline: -1px; border-radius: 3px; }
  .tk--arg, .tk--op { color: var(--ink-2); }
  .tk--str { color: var(--ink-2); font-style: italic; }
  .tk--flag { color: var(--ink-3); }
  .tk--lens { color: var(--ink); font-weight: 600; text-decoration: underline 2px var(--mark); text-underline-offset: 4px; text-decoration-skip-ink: none; }
  .tk--attach { color: var(--ink-3); font-style: italic; padding: 0 4px; border: 1px dashed var(--rule); border-radius: 3px; white-space: nowrap; }
  .copy__prompt { color: var(--ink-3); margin-right: 0.6ch; user-select: none; }
  .copy button { position: relative; display: grid; place-items: center; flex: none; width: 40px; height: 40px; border: 0; border-radius: 4px; background: none; color: var(--ink-2); cursor: pointer; touch-action: manipulation; transition: background-color var(--dur-state) var(--ease-out), color var(--dur-state) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .copy button:active { transform: scale(0.94); }
  .copy__icon, .copy__check { grid-area: 1 / 1; transition: opacity var(--dur-state) var(--ease-out), transform var(--dur-state) var(--ease-out); }
  .copy__check { opacity: 0; transform: scale(0.8); color: var(--ok); }
  .is-copied .copy__icon { opacity: 0; transform: scale(0.8); }
  .is-copied .copy__check { opacity: 1; transform: none; }
  .copy__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (hover: hover) and (pointer: fine) { .copy button:hover { background: var(--surface-2); color: var(--ink); } }
  @media (prefers-reduced-motion: reduce) { .copy button:active { transform: none; } .copy__icon, .copy__check { transform: none !important; } }
</style>
